---
/** Botón flotante de WhatsApp. Solo se renderiza si hay número en site.whatsapp. */
import { site } from '../lib/site';

const numero = (site as { whatsapp?: string }).whatsapp?.replace(/\D/g, '');
const texto = encodeURIComponent('Hola, vengo de 77delta.com y quiero hablar sobre IA para mi empresa.');
---

{
  numero && (
    <a
      href={`https://wa.me/${numero}?text=${texto}`}
      target="_blank"
      rel="noopener"
      aria-label="Escribir por WhatsApp"
      class="fixed bottom-6 right-6 z-40 grid h-13 w-13 place-items-center rounded-full border border-oro-luz/60 bg-tinta/90 text-oro-luz shadow-[0_16px_40px_-16px_rgba(0,0,0,.9)] backdrop-blur transition-[transform,background-color] duration-200 hover:-translate-y-0.5 hover:bg-oro hover:text-tinta-honda"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
        <path d="M12 2.2A9.8 9.8 0 0 0 3.6 17l-1.4 4.8 5-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.9a8 8 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.1 8.1 0 1 1 12 20.1Zm4.5-6c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4.1c1.7.7 2.4.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z" />
      </svg>
    </a>
  )
}
