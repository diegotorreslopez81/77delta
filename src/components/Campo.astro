---
/**
 * Escenario 3D de toda la página: una superficie de error (la que recorre una
 * red neuronal al aprender) y un punto de oro que desciende hasta el mínimo.
 * El scroll de la página mueve la cámara y el estado de la escena a través de
 * `window.__progreso` (0 arriba, 1 abajo), que escribe el script del inicio.
 * Con prefers-reduced-motion queda un fotograma fijo.
 */
---

<canvas data-campo class="pointer-events-none fixed inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>

<script>
  import * as THREE from 'three';

  declare global {
    interface Window {
      __progreso?: number;
    }
  }

  const canvas = document.querySelector<HTMLCanvasElement>('[data-campo]');
  if (canvas) iniciar(canvas);

  function iniciar(canvas: HTMLCanvasElement) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

    const escena = new THREE.Scene();
    escena.fog = new THREE.Fog(0x060b14, 7, 16);
    const camara = new THREE.PerspectiveCamera(38, 1, 0.1, 40);

    // Rejilla de puntos sobre el plano XZ.
    const movil = innerWidth < 768;
    const NX = movil ? 120 : 190, NZ = movil ? 76 : 120, ANCHO = 18, FONDO = 11;
    const n = NX * NZ;
    const pos = new Float32Array(n * 3);
    const col = new Float32Array(n * 3);
    const base = new Float32Array(n * 2);
    for (let z = 0, i = 0; z < NZ; z++) {
      for (let x = 0; x < NX; x++, i++) {
        const px = (x / (NX - 1) - 0.5) * ANCHO;
        const pz = (z / (NZ - 1) - 0.5) * FONDO;
        pos[i * 3] = px; pos[i * 3 + 2] = pz;
        base[i * 2] = px; base[i * 2 + 1] = pz;
      }
    }
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
    const mat = new THREE.PointsMaterial({ size: 0.05, vertexColors: true, transparent: true, opacity: 0.95, sizeAttenuation: true, depthWrite: false });
    escena.add(new THREE.Points(geo, mat));

    // La bola: el estado de la empresa bajando hasta el mínimo.
    const bola = new THREE.Mesh(new THREE.SphereGeometry(0.16, 32, 32), new THREE.MeshBasicMaterial({ color: 0xd4a03a }));
    const halo = new THREE.Mesh(new THREE.SphereGeometry(0.3, 32, 32), new THREE.MeshBasicMaterial({ color: 0xd4a03a, transparent: true, opacity: 0.2, depthWrite: false }));
    bola.add(halo);
    bola.visible = false;
    escena.add(bola);

    const pizarra = new THREE.Color(0xa3aebd);
    const tenue = new THREE.Color(0x4a5a72);
    const oro = new THREE.Color(0xd4a03a);

    // Claves de cámara y escena por progreso de scroll.
    const claves = [
      { p: 0.0, pos: [1.5, 3.4, 8.2], mira: [1.5, -0.6, 0], amp: 1.0, valle: 1.2 },
      { p: 0.15, pos: [-2.8, 2.4, 6.6], mira: [0.4, -0.6, 0], amp: 1.0, valle: 1.4 },
      { p: 0.33, pos: [4.2, 1.9, 5.4], mira: [2.2, -1.2, 0], amp: 1.1, valle: 1.7 },
      { p: 0.5, pos: [2.2, 5.6, 3.4], mira: [2.2, -1.6, 0], amp: 0.55, valle: 1.9 },
      { p: 0.7, pos: [0, 5.2, 10.5], mira: [0, -0.6, 0], amp: 0.5, valle: 1.2 },
      { p: 1.0, pos: [0, 2.4, 9.5], mira: [0, -0.2, 0], amp: 0.2, valle: 0.5 },
    ];
    const suav = (t: number) => t * t * (3 - 2 * t);
    function estado(p: number) {
      let i = 0;
      while (i < claves.length - 2 && p > claves[i + 1].p) i++;
      const a = claves[i], b = claves[i + 1];
      const t = suav(THREE.MathUtils.clamp((p - a.p) / (b.p - a.p), 0, 1));
      const l = (u: number, v: number) => u + (v - u) * t;
      return {
        pos: a.pos.map((v, k) => l(v, b.pos[k])),
        mira: a.mira.map((v, k) => l(v, b.mira[k])),
        amp: l(a.amp, b.amp),
        valle: l(a.valle, b.valle),
      };
    }

    const VX = 2.2, VZ = 0; // centro del valle
    function altura(x: number, z: number, t: number, amp: number, valle: number) {
      const cx = VX + Math.sin(t * 0.13) * 0.35, cz = VZ + Math.cos(t * 0.1) * 0.25;
      const d2 = (x - cx) * (x - cx) + (z - cz) * (z - cz);
      const hoyo = -valle * Math.exp(-d2 / 6);
      const ondas = amp * (0.22 * Math.sin(x * 0.7 + t * 0.5) * Math.cos(z * 0.9 - t * 0.35) + 0.1 * Math.sin((x + z) * 1.6 + t * 0.8));
      return hoyo + ondas;
    }

    function actualizar(t: number, amp: number, valle: number) {
      const p = geo.attributes.position.array as Float32Array;
      const c = geo.attributes.color.array as Float32Array;
      for (let k = 0; k < n; k++) {
        const x = base[k * 2], z = base[k * 2 + 1];
        const y = altura(x, z, t, amp, valle);
        p[k * 3 + 1] = y;
        const f = THREE.MathUtils.clamp((y + 0.2) / -1.1, 0, 1);
        const cc = f > 0.48 ? oro.clone().lerp(pizarra, (1 - f) * 1.4) : tenue.clone().lerp(pizarra, f * 1.7);
        c[k * 3] = cc.r; c[k * 3 + 1] = cc.g; c[k * 3 + 2] = cc.b;
      }
      geo.attributes.position.needsUpdate = true;
      geo.attributes.color.needsUpdate = true;
    }

    // Trayectoria de la bola: aparece a 0,12 y llega al fondo del valle a 0,5.
    function colocarBola(p: number, t: number, amp: number, valle: number) {
      if (p < 0.1) { bola.visible = false; return; }
      bola.visible = true;
      const u = suav(THREE.MathUtils.clamp((p - 0.12) / 0.38, 0, 1));
      const x = -4.8 + (VX + 4.8) * u;
      const z = -2.6 + (VZ + 2.6) * u + Math.sin(u * Math.PI) * 1.2;
      bola.position.set(x, altura(x, z, t, amp, valle) + 0.16, z);
      const esc = 0.4 + 0.6 * Math.min(1, (p - 0.1) / 0.06);
      bola.scale.setScalar(esc);
      halo.scale.setScalar(1 + 0.15 * Math.sin(t * 2.2));
    }

    function ajustar() {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      renderer.setSize(w, h, false);
      camara.aspect = w / h;
      camara.updateProjectionMatrix();
    }
    ajustar();
    addEventListener('resize', ajustar, { passive: true });

    let mx = 0, my = 0;
    addEventListener('pointermove', (e) => { mx = (e.clientX / innerWidth - 0.5) * 2; my = (e.clientY / innerHeight - 0.5) * 2; }, { passive: true });

    let pSuave = 0;
    const t0 = performance.now();
    function cuadro() {
      const t = (performance.now() - t0) / 1000;
      const objetivo = THREE.MathUtils.clamp(window.__progreso ?? 0, 0, 1);
      pSuave += (objetivo - pSuave) * 0.08;
      const e = estado(pSuave);
      actualizar(t, e.amp, e.valle);
      colocarBola(pSuave, t, e.amp, e.valle);
      camara.position.set(e.pos[0] + mx * 0.25, e.pos[1] - my * 0.2, e.pos[2]);
      camara.lookAt(e.mira[0], e.mira[1], e.mira[2]);
      renderer.render(escena, camara);
    }

    if (reduce) {
      const e = estado(0.33);
      actualizar(4, e.amp, e.valle);
      colocarBola(0.33, 4, e.amp, e.valle);
      camara.position.set(e.pos[0], e.pos[1], e.pos[2]);
      camara.lookAt(e.mira[0], e.mira[1], e.mira[2]);
      renderer.render(escena, camara);
      return;
    }
    let par = false;
    function bucle() {
      par = !par;
      if (!document.hidden && (!movil || par)) cuadro(); // 30 fps en móvil
      requestAnimationFrame(bucle);
    }
    bucle();
  }
</script>
