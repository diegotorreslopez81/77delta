---
/** Monograma 77Δ. Las tres figuras como una sola pieza; la Δ en oro. */
interface Props {
  /** Tamaño en px del texto. */
  size?: number;
  class?: string;
}
const { size = 22, class: extra = '' } = Astro.props;
---

<span class:list={['monograma', extra]} style={`font-size:${size}px`} aria-label="77 Delta"
  >77<span class="text-oro">Δ</span></span
>
