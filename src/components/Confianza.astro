---
/** Barra de confianza: instituciones y partners tecnológicos, en negro al 50 % sobre papel. */
import { instituciones, tecnologia } from '../data/logos';
import { href } from '../lib/site';

const todos = [...instituciones, ...tecnologia];
---

<section class="border-t border-linea bg-papel">
  <div class="wrap py-20 md:py-24">
    <div class="mx-auto max-w-[680px] text-center">
      <p class="eyebrow">Confianza demostrada</p>
      <h2 class="mt-4 font-display text-[clamp(26px,3vw,40px)] font-semibold leading-[1.15] tracking-[-0.02em]">
        Instituciones, corporaciones y partners tecnológicos de primer nivel
      </h2>
      <p class="mt-4 text-[16px] text-pizarra">Más de 7 años aplicando IA con criterio en Catalunya, Europa y el mundo.</p>
    </div>

    <ul class="mx-auto mt-12 grid max-w-[1080px] grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-6" role="list">
      {
        todos.map((l) => (
          <li class="flex min-h-16 items-center justify-center px-2">
            <a href={l.href} target="_blank" rel="noopener" title={l.alt} class="group block">
              <img
                src={href(`/img/logos/${l.src}`)}
                alt={l.alt}
                loading="lazy"
                decoding="async"
                class:list={[
                  'h-auto w-auto object-contain brightness-0 opacity-50 transition-[opacity,transform] duration-300 group-hover:scale-[1.04] group-hover:opacity-90',
                  l.forma === 'wide' ? 'max-h-7 max-w-[170px]' : l.forma === 'tall' ? 'max-h-12 max-w-[90px]' : 'max-h-9 max-w-[140px]',
                ]}
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
