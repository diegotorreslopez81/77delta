---
/** Barra de confianza: instituciones y partners tecnológicos, en gris sobre tinta. */
import { instituciones, tecnologia } from '../data/logos';
import { href } from '../lib/site';

const todos = [...instituciones, ...tecnologia];
---

<section class="hairline">
  <div class="wrap py-20 md:py-24" data-reveal>
    <p class="eyebrow">Confianza demostrada</p>
    <h2 class="mt-4 max-w-[26ch] font-display text-[clamp(24px,3vw,34px)] font-semibold leading-[1.15]">
      Instituciones, corporaciones y partners tecnológicos de primer nivel
    </h2>
    <p class="mt-3 text-pizarra">Más de 7 años aplicando IA con criterio en Catalunya, Europa y el mundo.</p>

    <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-6" role="list">
      {
        todos.map((l) => (
          <li class="flex min-h-16 items-center justify-center">
            <a href={l.href} target="_blank" rel="noopener" title={l.alt} class="group block">
              <img
                src={href(`/img/logos/${l.src}`)}
                alt={l.alt}
                loading="lazy"
                decoding="async"
                class:list={[
                  'h-auto w-auto object-contain brightness-0 invert opacity-45 transition-opacity duration-300 group-hover:opacity-90',
                  l.forma === 'wide' ? 'max-h-7 max-w-[160px]' : l.forma === 'tall' ? 'max-h-12 max-w-[90px]' : 'max-h-9 max-w-[130px]',
                ]}
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
