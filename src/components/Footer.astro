---
/** Pie de página: franja de tinta, como en la web anterior. */
import Monograma from './Monograma.astro';
import { site, href, hrefCa } from '../lib/site';

const idioma = Astro.currentLocale === 'ca' ? 'ca' : 'es';
const enlace = idioma === 'ca' ? hrefCa : href;

const columnasEs = [
  {
    titulo: 'Servicios',
    enlaces: [
      { texto: 'Diagnóstico', ruta: '/servicios/diagnostico/' },
      { texto: 'Transformación operativa', ruta: '/servicios/transformacion/' },
      { texto: 'Partner tecnológico', ruta: '/servicios/partner/' },
      { texto: 'Seguridad de IA', ruta: '/servicios/seguridad-ia/' },
      { texto: 'Acreditación ACCIÓ', ruta: '/servicios/#cupo' },
      { texto: 'Sectores', ruta: '/sectores/' },
      { texto: 'Casos de uso', ruta: '/casos-de-uso/' },
      { texto: 'Historias de éxito', ruta: '/historias-de-exito/' },
    ],
  },
  {
    titulo: 'Productos',
    enlaces: [
      { texto: 'Licita', ruta: '/licita/' },
      { texto: 'LeakAI', ruta: '/productos/leakai/' },
      { texto: 'Regulia', ruta: '/productos/regulia/' },
      { texto: 'Contestia', ruta: '/productos/contestia/' },
      { texto: 'InstantExam', ruta: '/productos/instantexam/' },
      { texto: 'ScoreFlow', ruta: '/productos/scoreflow/' },
      { texto: 'Contablia', ruta: '/productos/contablia/' },
      { texto: 'Swarmix', ruta: '/productos/swarmix/' },
      { texto: 'Corpora', ruta: '/productos/#corpora' },
    ],
  },
  {
    titulo: 'Empresa',
    enlaces: [
      { texto: 'Sobre nosotros', ruta: '/sobre-nosotros/' },
      { texto: 'Contacto', ruta: '/contacto/' },
    ],
  },
  {
    titulo: 'Legal',
    enlaces: [
      { texto: 'Aviso legal', ruta: '/aviso-legal/' },
      { texto: 'Privacidad', ruta: '/politica-privacidad/' },
      { texto: 'Cookies', ruta: '/politica-cookies/' },
    ],
  },
];

const columnasCa = [
  {
    titulo: 'Serveis',
    enlaces: [
      { texto: 'Diagnòstic', ruta: '/servicios/diagnostico/' },
      { texto: 'Transformació operativa', ruta: '/servicios/transformacion/' },
      { texto: 'Soci tecnològic', ruta: '/servicios/partner/' },
      { texto: 'Seguretat d’IA', ruta: '/servicios/seguridad-ia/' },
      { texto: 'Acreditació ACCIÓ', ruta: '/servicios/#cupo' },
      { texto: 'Sectors', ruta: '/sectores/' },
      { texto: "Casos d'ús", ruta: '/casos-de-uso/' },
      { texto: "Històries d'èxit", ruta: '/historias-de-exito/' },
    ],
  },
  {
    titulo: 'Productes',
    enlaces: [
      { texto: 'Licita', ruta: '/licita/' },
      { texto: 'LeakAI', ruta: '/productos/leakai/' },
      { texto: 'Regulia', ruta: '/productos/regulia/' },
      { texto: 'Contestia', ruta: '/productos/contestia/' },
      { texto: 'InstantExam', ruta: '/productos/instantexam/' },
      { texto: 'ScoreFlow', ruta: '/productos/scoreflow/' },
      { texto: 'Contablia', ruta: '/productos/contablia/' },
      { texto: 'Swarmix', ruta: '/productos/swarmix/' },
      { texto: 'Corpora', ruta: '/productos/#corpora' },
    ],
  },
  {
    titulo: 'Empresa',
    enlaces: [
      { texto: 'Sobre nosaltres', ruta: '/sobre-nosotros/' },
      { texto: 'Contacte', ruta: '/contacto/' },
    ],
  },
  {
    titulo: 'Legal',
    enlaces: [
      { texto: 'Avís legal', ruta: '/aviso-legal/' },
      { texto: 'Privacitat', ruta: '/politica-privacidad/' },
      { texto: 'Cookies', ruta: '/politica-cookies/' },
    ],
  },
];

const columnas = idioma === 'ca' ? columnasCa : columnasEs;
---

<footer class="bg-marino text-marfil/70">
  <div class="wrap grid gap-10 py-20 md:grid-cols-[1.6fr_repeat(4,1fr)]">
    <div>
      <a href={enlace('/')} class="text-marfil" aria-label="77 Delta, inici"><Monograma size={30} /></a>
      {
        idioma === 'ca' ? (
          <p class="mt-5 max-w-[28ch] text-[14px] leading-[1.55] text-marfil/60">
            Consultora tecnològica especialitzada en pimes. Transformem pimes amb intel·ligència artificial
            aplicada amb criteri.
          </p>
        ) : (
          <p class="mt-5 max-w-[28ch] text-[14px] leading-[1.55] text-marfil/60">
            Consultora tecnológica especializada en pymes. Transformamos pymes con inteligencia artificial aplicada
            con criterio.
          </p>
        )
      }
      <p class="mt-6 text-[13px] text-marfil/55">
        {idioma === 'ca' ? 'Oficina a ' : 'Oficina en '}
        <strong class="font-semibold text-marfil/85">{site.ciudad}</strong>
      </p>
    </div>

    {
      columnas.map((c) => (
        <div>
          <h4 class="mb-4 text-[13px] font-semibold uppercase tracking-[0.05em] text-marfil">{c.titulo}</h4>
          <ul class="space-y-2.5">
            {c.enlaces.map((e) => (
              <li>
                <a href={enlace(e.ruta)} class="text-[14px] text-marfil/65 transition-colors hover:text-marfil">
                  {e.texto}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-marfil/10">
    <div class="wrap flex flex-col gap-3 py-8 text-[13px] text-marfil/50 md:flex-row md:items-center md:justify-between">
      {
        idioma === 'ca' ? (
          <p>
            © {site.anio} {site.nombre} és una marca de <strong class="font-semibold text-marfil/80">{site.sociedad}</strong> ·
            CIF {site.cif} · {site.direccion}
          </p>
        ) : (
          <p>
            © {site.anio} {site.nombre} es una marca de <strong class="font-semibold text-marfil/80">{site.sociedad}</strong> ·
            CIF {site.cif} · {site.direccion}
          </p>
        )
      }
      <p class="flex items-center gap-5 whitespace-nowrap">
        <span>{idioma === 'ca' ? 'Dades processades a la Unió Europea · RGPD' : 'Datos procesados en la Unión Europea · RGPD'}</span>
        <a href={site.linkedin} target="_blank" rel="noopener" class="transition-colors hover:text-marfil">LinkedIn</a>
      </p>
    </div>
  </div>
</footer>
