  clinicas: '<path d="M12 4l8 14H4z"/><path d="M12 10v6M9 13h6"/>',
  industria: '<path d="M3 20V9l5 3V9l5 3V9l5 3v8z"/><path d="M3 20h18"/><path d="M8 17h2M13 17h2"/>',
  distribucion: '<path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>',
