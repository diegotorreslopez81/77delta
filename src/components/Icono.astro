  administracion: '<path d="M3 21h18"/><path d="M6 21v-9M10 21v-9M14 21v-9M18 21v-9"/><path d="M3 12l9-7 9 7z"/>',
  formacion: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11.5V16c0 1.6 2.7 3 6 3s6-1.4 6-3v-4.5"/><path d="M22 9v5"/>',
  reloj: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
