} as const;

interface Props {
  nombre: keyof typeof iconos;
  class?: string;
}
const { nombre, class: extra = 'h-6 w-6' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={extra}
  aria-hidden="true"
  set:html={iconos[nombre]}
/>
