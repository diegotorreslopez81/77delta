---
/** Borrador B: la estructura de la web anterior (infinitelabs.co) con la paleta, el logo y el campo 3D de 77 Delta. No indexado. */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Boton from '../../components/Boton.astro';
import Campo from '../../components/Campo.astro';
import Cta from '../../components/Cta.astro';
import Confianza from '../../components/Confianza.astro';
import Icono from '../../components/Icono.astro';
import Marcador from '../../components/Marcador.astro';
import Delta from '../../components/Delta.astro';
import { site, href } from '../../lib/site';
import { sectores } from '../../data/sectores';
import { casos } from '../../data/casos';
import { productos } from '../../data/productos';
import campus from '../../assets/campus.jpg';
import diego from '../../assets/diego.png';

const servicios = [
  { icono: 'medir', etiqueta: 'Primer paso · gratuito · 30 min', titulo: 'Diagnóstico', texto: '30 minutos de entrevista estructurada. Recibes una propuesta con el estado inicial de tu empresa, plan de trabajo y presupuesto. Sin compromiso.', pie: 'Gratuito', ruta: '/servicios/#diagnostico' },
  { icono: 'produccion', etiqueta: 'Proyecto a medida', titulo: 'Transformación operativa con IA', texto: 'Implantación, integración con tus sistemas, automatización de procesos y capacitación de tu equipo. La inversión se define en la propuesta.', pie: 'Cotización en propuesta', ruta: '/servicios/#transformacion' },
  { icono: 'partner', etiqueta: 'Mensualidad', titulo: 'Partner tecnológico', texto: 'Criterio técnico cada mes: revisamos propuestas de proveedores, participamos en decisiones e identificamos oportunidades.', pie: 'Desde 1.000 € al mes', ruta: '/servicios/#partner' },
] as const;

const razones = [
  { icono: 'transformacion', titulo: 'Transformación transversal, no solo tecnología', texto: 'La IA cambia procesos, equipos y formas de decidir. Acompañamos la transformación completa.' },
  { icono: 'partner', titulo: 'La IA aumenta a las personas', texto: 'Human-in-the-loop por defecto: liberamos tiempo de tareas repetitivas para lo que aporta valor.' },
  { icono: 'produccion', titulo: 'Construimos lo que implantamos', texto: 'Operamos productos propios en producción con empresas reales.' },
  { icono: 'administracion', titulo: 'Datos en Europa', texto: 'Infraestructura propia en la UE. RGPD. Soporte en español y catalán.' },
  { icono: 'medir', titulo: 'Resultados medidos en horas y en ventas', texto: 'Cada proyecto empieza con una estimación cuantificada y seguimiento mensual.' },
  { icono: 'propuesta', titulo: 'Sin dependencia tecnológica', texto: 'Al final conservas el código, las claves, los datos y la documentación.' },
] as const;

const h2 = 'font-display text-[clamp(30px,4vw,52px)] font-extralight leading-[1.06] tracking-[-0.03em] text-marfil';
---

<Base title="Borrador B" description="Borrador de estructura clásica con la identidad de 77 Delta." noindex>
  <!-- Hero asimétrico: texto y campo 3D -->
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-tinta">
      <Campo modo="absoluto" />
      <div class="absolute inset-x-0 bottom-0 h-1/3 bg-[linear-gradient(to_top,#060B14,transparent)]"></div>
    </div>
    <div class="wrap grid min-h-[86svh] items-center gap-10 py-24 md:grid-cols-12">
      <div class="sombra-texto md:col-span-7">
        <p class="eyebrow">Acreditados ACCIÓ · Generalitat de Catalunya</p>
        <h1 class="mt-6 max-w-[14ch] font-display text-[clamp(40px,6.4vw,84px)] font-extralight leading-[1] tracking-[-0.035em]">
          Aplicamos la IA para <span class="font-semibold text-oro-luz">ahorrar costes</span> a tu empresa.
        </h1>
        <p class="mt-7 max-w-[46ch] text-[clamp(17px,1.4vw,20px)] text-pizarra">
          Consultora tecnológica especializada en pymes. Diagnóstico gratuito, transformación operativa con IA y partner tecnológico.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Boton href={href('/contacto/')}>Reservar diagnóstico →</Boton>
          <Boton href={href('/servicios/')} variante="linea">Ver cómo trabajamos</Boton>
        </div>
      </div>
      <div class="hidden md:col-span-5 md:block">
        <div class="ml-auto max-w-[380px] rounded-[6px] border border-linea bg-tinta/70 p-6 backdrop-blur-sm">
          <Marcador n="Δ" texto="Antes y después" />
          <ul class="mt-5 divide-y divide-linea" role="list">
            {casos.slice(0, 3).map((c) => (
              <li class="flex items-baseline justify-between gap-4 py-3">
                <span class="font-display text-[34px] font-extralight tracking-[-0.04em] text-marfil">{c.valor}<span class="text-oro-luz">{c.sufijo}</span></span>
                <span class="text-right text-[13px] text-pizarra">{c.etiqueta}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- El problema -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12">
      <div class="md:col-span-7">
        <Marcador n="01" texto="El problema" />
        <h2 class:list={[h2, 'mt-5']}>La inteligencia artificial está reordenando tu sector. La pregunta no es si te afectará, sino cómo aplicarla bien.</h2>
      </div>
      <div class="space-y-5 text-[17px] text-pizarra md:col-span-5 md:pt-10">
        <p>Distinguir lo que transforma tu negocio de lo que solo suena interesante requiere criterio. La transformación toca procesos, equipos y formas de decidir.</p>
        <p class="text-marfil">¿Qué tareas repetitivas consumen el día de tu equipo? ¿Qué decisiones se toman sin datos? ¿Qué pasa cuando una persona clave no está?</p>
      </div>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section class="hairline">
    <div class="wrap py-24">
      <Marcador n="02" texto="Cómo trabajamos" />
      <h2 class:list={[h2, 'mt-5 max-w-[24ch]']}>Empezamos por un diagnóstico. Después, tú decides el recorrido.</h2>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea md:grid-cols-3">
        {servicios.map((s) => (
          <a href={href(s.ruta)} class="group flex flex-col bg-tinta p-8 transition-colors hover:bg-tinta-honda">
            <span class="grid h-12 w-12 place-items-center rounded-[6px] bg-oro/10 text-oro-luz"><Icono nombre={s.icono} class="h-7 w-7" /></span>
            <span class="eyebrow mt-6 text-pizarra">{s.etiqueta}</span>
            <h3 class="mt-3 font-display text-[22px] font-semibold">{s.titulo}</h3>
            <p class="mt-4 flex-1 text-[15px] text-pizarra">{s.texto}</p>
            <span class="mt-8 font-display text-[14px] text-oro-luz">{s.pie} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Sectores -->
  <section class="hairline bg-tinta-honda">
    <div class="wrap py-24">
      <Marcador n="03" texto="Sectores" />
      <h2 class:list={[h2, 'mt-5']}>Seis sectores. Una metodología.</h2>
      <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {sectores.map((s) => (
          <li>
            <a href={href(`/sectores/${s.slug}/`)} class="group block h-full rounded-[4px] border border-linea bg-tinta p-6 transition-[border-color,transform] duration-300 textura-delta hover:-translate-y-1 hover:border-oro-luz/70">
              <span class="grid h-12 w-12 place-items-center rounded-[6px] bg-oro/10 text-oro-luz"><Icono nombre={s.slug as 'clinicas'} class="h-7 w-7" /></span>
              <p class="mt-5 font-display text-[20px] leading-tight text-marfil">{s.nombre}</p>
              <p class="mt-2 text-[14px] leading-snug text-pizarra">{s.resumen}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Casos -->
  <section class="hairline">
    <div class="wrap py-24">
      <Marcador n="04" texto="Historias de éxito" />
      <h2 class:list={[h2, 'mt-5']}>Resultados que se pueden contar.</h2>
      <ol class="mt-8" role="list">
        {casos.slice(0, 3).map((c, i) => (
          <li class="grid gap-6 border-t border-linea py-12 md:grid-cols-12 md:gap-10">
            <div class="md:col-span-4">
              <p class="font-display text-[clamp(56px,7vw,104px)] font-extralight leading-none tracking-[-0.04em] text-marfil">{c.valor}<span class="text-oro-luz">{c.sufijo}</span></p>
              <p class="mt-2 font-display text-[13px] uppercase tracking-[0.1em] text-pizarra">{c.etiqueta}</p>
            </div>
            <div class="md:col-span-8">
              <p class="eyebrow text-pizarra">Caso {i + 1} · {c.meta}</p>
              <h3 class="mt-3 font-display text-[clamp(20px,2vw,26px)] font-semibold leading-tight">{c.titulo}</h3>
              <p class="mt-4 text-[15px] text-pizarra">{c.solucion}</p>
              {c.historia && <a href={href(`/historias-de-exito/${c.historia}/`)} class="mt-4 inline-block font-display text-[14px] text-oro-luz">Leer el caso →</a>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Seis razones -->
  <section class="hairline bg-tinta-honda">
    <div class="wrap py-24">
      <Marcador n="05" texto={`Por qué ${site.nombre}`} />
      <h2 class:list={[h2, 'mt-5']}>Seis razones para confiar en nosotros</h2>
      <ol class="mt-14 grid gap-x-10 gap-y-10 md:grid-cols-2 lg:grid-cols-3" role="list">
        {razones.map((r) => (
          <li class="flex gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-[6px] bg-oro/10 text-oro-luz"><Icono nombre={r.icono} class="h-6 w-6" /></span>
            <div>
              <h3 class="font-display text-[17px] font-semibold">{r.titulo}</h3>
              <p class="mt-2 text-[14px] text-pizarra">{r.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Productos -->
  <section class="hairline">
    <div class="wrap py-24">
      <Marcador n="06" texto="Productos propios" />
      <h2 class:list={[h2, 'mt-5 max-w-[20ch]']}>Construimos lo que implantamos.</h2>
      <ul class="mt-12 flex flex-wrap gap-x-10 gap-y-5" role="list">
        {productos.map((p) => (
          <li>
            <a href={href('/productos/#' + p.slug)} class="group flex items-center gap-3">
              <img src={href(`/img/productos/${p.logo}`)} alt="" width="256" height="256" loading="lazy" class="h-9 w-9 rounded-[6px] ring-1 ring-linea" />
              <span class="font-display text-[19px] text-marfil transition-colors group-hover:text-oro-luz">{p.nombre}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Sobre nosotros con fotos -->
  <section class="hairline bg-tinta-honda">
    <div class="wrap grid items-center gap-12 py-24 md:grid-cols-12">
      <div class="relative md:col-span-6">
        <Image src={campus} alt="Campus tecnológico" width={1100} format="webp" quality={72} class="w-full rounded-[6px] border border-linea object-cover grayscale-[35%]" />
        <div class="absolute -bottom-6 left-6 flex items-center gap-4 rounded-[6px] border border-linea bg-tinta p-3 pr-5 shadow-[0_20px_50px_-20px_rgba(0,0,0,.9)]">
          <Image src={diego} alt="Diego Torres" width={160} format="webp" class="h-14 w-14 rounded-[6px] object-cover grayscale" />
          <div>
            <p class="font-display text-[15px] text-marfil">Diego Torres</p>
            <p class="text-[12px] text-pizarra">Fundador y director técnico</p>
          </div>
        </div>
      </div>
      <div class="md:col-span-6">
        <Marcador n="07" texto="Sobre nosotros" />
        <h2 class:list={[h2, 'mt-5']}>Una consultora con historia, nacida desde dentro del problema.</h2>
        <p class="mt-6 text-[16px] text-pizarra">Más de 20 años aplicando tecnología a empresas reales. Acreditados por la Generalitat de Catalunya. Con clientes desde Barcelona hasta Dubái. Y con una convicción: la IA solo aporta valor cuando se aplica con criterio.</p>
        <p class="mt-4 flex items-center gap-2 text-[16px] text-marfil"><Delta class="h-[0.7em] text-oro-luz" /> El 77 es nuestro. No lo explicamos.</p>
        <a href={href('/sobre-nosotros/')} class="mt-6 inline-block font-display text-[14px] text-oro-luz">Conócenos →</a>
      </div>
    </div>
  </section>

  <Cta />
  <Confianza />
</Base>
