---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { href } from '../../lib/site';
import { historias } from '../../data/historias';
---

<Base
  title="Historias de éxito"
  description="Tres proyectos reales con resultados verificados: 38% menos ausencias en consulta, 2h recuperadas por comercial y día, 20h liberadas por socio sénior al mes."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>Casos reales</p>
    <h1
      class="mt-7 max-w-[16ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      Tres proyectos. <span class="font-semibold text-oro-luz">Tres cifras verificables.</span>
    </h1>
    <p class="mt-8 max-w-[58ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      No prometemos: medimos. Cada proyecto empieza con una estimación cuantificada del retorno y se sigue con
      métricas verificables mes a mes. Estos son tres casos reales de empresas que pueden contar lo que ha cambiado
      tras trabajar con nosotros.
    </p>
  </section>

  <!-- Las tres historias -->
  <section class="hairline">
    <div class="wrap py-8 md:py-12">
      <ol role="list">
        {
          historias.map((h, i) => (
            <li class="border-b border-linea last:border-b-0">
              <a
                href={href(`/historias-de-exito/${h.slug}/`)}
                class="group grid gap-6 py-14 transition-colors md:grid-cols-12 md:gap-10 md:py-20"
                data-reveal
              >
                <div class="md:col-span-5">
                  <p class="font-display text-[clamp(64px,9vw,128px)] font-extralight leading-none tracking-[-0.04em] text-oro-luz">
                    <span data-contador={h.cifra.valor} data-sufijo={h.cifra.sufijo}>{`${h.cifra.valor}${h.cifra.sufijo}`}</span>
                  </p>
                  <p class="mt-3 font-mono text-[12px] uppercase tracking-[0.14em] text-pizarra">{h.etiqueta}</p>
                </div>
                <div class="md:col-span-7">
                  <p class="eyebrow text-pizarra">
                    Historia {i + 1} de {historias.length} · {h.sector}
                  </p>
                  <h2 class="mt-4 font-display text-[clamp(22px,2.4vw,30px)] font-semibold leading-[1.2]">
                    {h.cliente}
                  </h2>
                  <p class="mt-5 text-[16px] text-pizarra">{h.resumen}</p>
                  <span class="mt-6 inline-block font-mono text-[12px] text-oro-luz group-hover:text-marfil">
                    Leer el caso completo →
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Cta
    titulo="¿Quieres ser el cuarto caso?"
    texto="Diagnóstico de 30 minutos. Te entregamos propuesta personalizada con plan de trabajo y presupuesto. Sin compromiso."
  />
</Base>
