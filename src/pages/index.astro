---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Boton from '../components/Boton.astro';
import Campo from '../components/Campo.astro';
import { site, href } from '../lib/site';
import { sectores } from '../data/sectores';
import regulia from '../assets/productos/regulia.webp';
import contestia from '../assets/productos/contestia.webp';
import instantexam from '../assets/productos/instantexam.webp';
import swarmix from '../assets/productos/swarmix.webp';

const cifras = [
  { valor: 38, sufijo: '%', frase: 'menos ausencias en tres clínicas dentales', historia: 'clinicas-dentales-barcelona' },
  { valor: 2, sufijo: 'h', frase: 'al día recuperadas por cada comercial', historia: 'distribuidora-industrial' },
  { valor: 20, sufijo: 'h', frase: 'al mes liberadas por socio en un despacho', historia: 'despacho-mercantil' },
];

const capturas = [
  { img: regulia, nombre: 'Regulia', que: 'Cumplimiento europeo automatizado', slug: 'regulia' },
  { img: contestia, nombre: 'Contestia', que: 'Recepcionista por WhatsApp para clínicas', slug: 'contestia' },
  { img: instantexam, nombre: 'InstantExam', que: 'Exámenes con IA en 30 segundos', slug: 'instantexam' },
  { img: swarmix, nombre: 'Swarmix', que: 'Prospección con agentes', slug: 'swarmix' },
];

const h2 = 'font-display text-[clamp(38px,6.4vw,96px)] font-extralight leading-[0.98] tracking-[-0.04em] text-marfil';
const linea = 'mt-7 max-w-[34ch] font-display text-[clamp(17px,1.6vw,23px)] font-normal leading-snug text-marfil/75';
---

<Base title="" description={site.descripcion}>
  <Campo />

  <!-- 1 · Hero -->
  <section class="flex min-h-[100svh] flex-col justify-end" data-panel data-hero>
    <div class="wrap sombra-texto pb-20 md:pb-24" data-cont>
      <h1 class="max-w-[13ch] font-display text-[clamp(44px,8.6vw,124px)] font-extralight leading-[0.98] tracking-[-0.04em]">
        Aplicamos la IA para <span class="font-semibold text-oro">ahorrar costes</span> a tu empresa.
      </h1>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <Boton href={href('/contacto/')}>Reservar diagnóstico</Boton>
        <p class="font-display text-[15px] text-pizarra">Consultora de IA para pymes · {site.ciudad}</p>
      </div>
    </div>
  </section>

  <!-- 2 · Medir -->
  <section class="flex min-h-[100svh] items-center" data-panel>
    <div class="wrap sombra-texto flex justify-end" data-cont>
      <div class="md:w-1/2">
        <h2 class={h2}>Primero medimos dónde estás.</h2>
        <p class={linea}>Treinta minutos, gratis. Te decimos dónde la IA ahorra horas en tu empresa y dónde no.</p>
        <a href={href('/servicios/#diagnostico')} class="mt-8 inline-block font-display text-[15px] text-marfil/80 hover:text-oro">Diagnóstico →</a>
      </div>
    </div>
  </section>

  <!-- 3 · Construir -->
  <section class="flex min-h-[100svh] items-center" data-panel>
    <div class="wrap sombra-texto" data-cont>
      <div class="md:w-[56%]">
        <h2 class={h2}>Construimos hasta que entra en producción.</h2>
        <p class={linea}>Integrado con tus sistemas. Tu equipo formado. Sin pilotos que no acaban nunca.</p>
        <a href={href('/servicios/#transformacion')} class="mt-8 inline-block font-display text-[15px] text-marfil/80 hover:text-oro">Transformación →</a>
      </div>
    </div>
  </section>

  <!-- 4 · Medir otra vez · cifras -->
  <section class="relative h-[280vh]" data-panel data-cifras>
    <div class="sticky top-0 flex h-[100svh] items-center sombra-texto" data-cont>
      <div class="wrap">
        <p class="font-display text-[clamp(20px,2.2vw,30px)] font-normal text-pizarra">Después medimos otra vez.</p>
        <div class="relative mt-6 h-[52vh]">
          {
            cifras.map((c, i) => (
              <article class="absolute inset-0 flex flex-col justify-center" data-cifra={i} style={i === 0 ? '' : 'opacity:0'}>
                <p class="font-display text-[clamp(110px,24vw,340px)] font-extralight leading-[0.9] tracking-[-0.06em] text-marfil">
                  <span data-num={c.valor}>{c.valor}</span><span class="text-oro">{c.sufijo}</span>
                </p>
                <p class="mt-6 max-w-[26ch] font-display text-[clamp(20px,2.6vw,36px)] font-normal leading-tight text-pizarra">{c.frase}</p>
                <a href={href(`/historias-de-exito/${c.historia}/`)} class="mt-6 inline-block font-display text-[15px] text-marfil/80 hover:text-oro">Leer el caso →</a>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · Sectores -->
  <section class="flex min-h-[100svh] items-center" data-panel>
    <div class="wrap sombra-texto" data-cont>
      <h2 class={h2}>Seis sectores.<br />Una metodología.</h2>
      <ul class="mt-10 flex max-w-[60ch] flex-wrap gap-x-7 gap-y-3" role="list">
        {
          sectores.map((s) => (
            <li>
              <a href={href(`/sectores/${s.slug}/`)} class="font-display text-[clamp(17px,1.7vw,24px)] text-marfil/85 transition-colors hover:text-oro">{s.nombre}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6 · Productos · tira horizontal -->
  <section class="relative h-[240vh]" data-panel data-productos>
    <div class="sticky top-0 flex h-[100svh] flex-col justify-start overflow-hidden pt-[11vh] sombra-texto" data-cont>
      <div class="wrap">
        <h2 class="font-display text-[clamp(32px,4.8vw,68px)] font-extralight leading-[1] tracking-[-0.035em] text-marfil">Construimos lo que implantamos.</h2>
        <p class="mt-4 max-w-[40ch] font-display text-[clamp(16px,1.4vw,20px)] text-marfil/75">Productos propios en producción con clientes reales. Nuestro laboratorio.</p>
      </div>
      <div class="mt-8 flex w-max gap-8 pl-[max(24px,calc((100vw-1120px)/2))] [perspective:1400px]" data-tira>
        {
          capturas.map((c) => (
            <a href={href(`/productos/#${c.slug}`)} class="group block w-[min(66vw,600px)] shrink-0 [transform:rotateY(-6deg)] transition-transform duration-500 hover:[transform:rotateY(0deg)]">
              <Image src={c.img} alt={`Web de ${c.nombre}`} width={1200} format="webp" quality={78} class="w-full rounded-[6px] border border-linea shadow-[0_30px_80px_-30px_rgba(0,0,0,.8)]" loading="lazy" />
              <p class="mt-4 font-display text-[18px] text-marfil">{c.nombre} <span class="text-pizarra">· {c.que}</span></p>
            </a>
          ))
        }
        <a href={href('/productos/')} class="flex w-[40vw] shrink-0 items-center font-display text-[clamp(20px,2.4vw,32px)] text-marfil/80 hover:text-oro">Los siete productos →</a>
      </div>
    </div>
  </section>

  <!-- 7 · Cierre -->
  <section class="flex min-h-[100svh] items-center" data-panel>
    <div class="wrap sombra-texto" data-cont>
      <h2 class="font-display text-[clamp(44px,8vw,124px)] font-extralight leading-[0.96] tracking-[-0.045em]">
        30 minutos.<br /><span class="text-pizarra">Sin compromiso.</span>
      </h2>
      <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4">
        <Boton href={href('/contacto/')}>Reservar diagnóstico</Boton>
        <a href={href('/servicios/')} class="font-display text-[15px] text-marfil/80 hover:text-oro">Cómo trabajamos →</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll suavizado.
  if (!reduce) {
    const lenis = new Lenis({ lerp: 0.085, smoothWheel: true });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((t) => lenis.raf(t * 1000));
    gsap.ticker.lagSmoothing(0);
  }

  // Progreso global para el escenario 3D.
  ScrollTrigger.create({
    start: 0,
    end: () => document.documentElement.scrollHeight - innerHeight,
    onUpdate: (s) => { window.__progreso = s.progress; },
  });

  // Cada panel entra, se sostiene y sale con el scroll.
  document.querySelectorAll<HTMLElement>('[data-panel]').forEach((sec) => {
    const cont = sec.querySelector<HTMLElement>('[data-cont]');
    if (!cont) return;
    const tl = gsap.timeline({ scrollTrigger: { trigger: sec, start: 'top bottom', end: 'bottom top', scrub: reduce ? false : 0.35 } });
    if (sec.hasAttribute('data-hero')) tl.to({}, { duration: 0.35 });
    else tl.fromTo(cont, { opacity: 0, y: 70 }, { opacity: 1, y: 0, duration: 0.28, ease: 'power2.out' });
    tl.to({}, { duration: 0.42 });
    tl.to(cont, { opacity: 0, y: -70, duration: 0.25, ease: 'power2.in' });
  });

  // Cifras que se suceden dentro de su tramo fijo.
  const cifras = gsap.utils.toArray<HTMLElement>('[data-cifra]');
  if (cifras.length > 1) {
    const tl = gsap.timeline({ scrollTrigger: { trigger: '[data-cifras]', start: 'top top', end: 'bottom bottom', scrub: reduce ? false : 0.5 } });
    cifras.forEach((el, i) => {
      if (i > 0) {
        tl.to(cifras[i - 1], { opacity: 0, y: -50, duration: 0.5, ease: 'power2.in' }, `c${i}`);
        tl.fromTo(el, { opacity: 0, y: 70 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, `c${i}+=0.25`);
      }
      tl.to({}, { duration: 1 });
    });
  }

  // Tira de productos: avanza en horizontal con el scroll.
  const tira = document.querySelector<HTMLElement>('[data-tira]');
  if (tira) {
    gsap.to(tira, {
      x: () => -(tira.scrollWidth - innerWidth + 24),
      ease: 'none',
      scrollTrigger: { trigger: '[data-productos]', start: 'top top', end: 'bottom bottom', scrub: reduce ? false : 0.5, invalidateOnRefresh: true },
    });
  }

  // Números: cuentan la primera vez que se muestran.
  gsap.utils.toArray<HTMLElement>('[data-num]').forEach((el) => {
    const fin = Number(el.dataset.num);
    if (reduce) return;
    const obj = { v: 0 };
    ScrollTrigger.create({
      trigger: el, start: 'top 90%', once: true,
      onEnter: () => gsap.to(obj, { v: fin, duration: 1.2, ease: 'power2.out', onUpdate: () => (el.textContent = String(Math.round(obj.v))) }),
    });
  });
</script>
