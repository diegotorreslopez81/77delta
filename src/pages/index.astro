---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Boton from '../components/Boton.astro';
import Campo from '../components/Campo.astro';
import Delta from '../components/Delta.astro';
import Icono from '../components/Icono.astro';
import Marcador from '../components/Marcador.astro';
import { site, href } from '../lib/site';
import { sectores } from '../data/sectores';
import regulia from '../assets/productos/regulia.webp';
import contestia from '../assets/productos/contestia.webp';
import instantexam from '../assets/productos/instantexam.webp';
import swarmix from '../assets/productos/swarmix.webp';

const pasos = [
  { icono: 'piloto', nombre: 'Piloto', texto: 'Versión mínima en un proceso acotado.' },
  { icono: 'integracion', nombre: 'Integración', texto: 'ERP, CRM, WhatsApp, agenda. Datos de punta a punta.' },
  { icono: 'produccion', nombre: 'Producción', texto: 'Salida real, equipo formado, medición desde el día uno.' },
] as const;

const cifras = [
  { valor: 38, sufijo: '%', frase: 'menos ausencias en tres clínicas dentales', historia: 'clinicas-dentales-barcelona', icono: 'clinicas', meta: 'Clínicas dentales · Barcelona' },
  { valor: 2, sufijo: 'h', frase: 'al día recuperadas por cada comercial', historia: 'distribuidora-industrial', icono: 'distribucion', meta: 'Distribución industrial · Catalunya' },
  { valor: 20, sufijo: 'h', frase: 'al mes liberadas por socio en un despacho', historia: 'despacho-mercantil', icono: 'despachos', meta: 'Derecho mercantil · Madrid' },
] as const;

const capturas = [
  { img: regulia, nombre: 'Regulia', que: 'Cumplimiento europeo automatizado', slug: 'regulia', url: 'regulia.app' },
  { img: contestia, nombre: 'Contestia', que: 'Recepcionista por WhatsApp para clínicas', slug: 'contestia', url: 'contestia.co' },
  { img: instantexam, nombre: 'InstantExam', que: 'Exámenes con IA en 30 segundos', slug: 'instantexam', url: 'instantexam.co' },
  { img: swarmix, nombre: 'Swarmix', que: 'Prospección con agentes', slug: 'swarmix', url: 'swarmix.co' },
];

const datosCierre = [
  { icono: 'reloj', texto: '30 minutos' },
  { icono: 'euro', texto: 'Sin coste' },
  { icono: 'propuesta', texto: 'Propuesta tras la llamada' },
] as const;

const h2 = 'font-display text-[clamp(36px,6vw,92px)] font-extralight leading-[0.98] tracking-[-0.04em] text-marfil';
const linea = 'mt-6 max-w-[34ch] font-display text-[clamp(17px,1.5vw,22px)] font-normal leading-snug text-marfil/75';
const enlace = 'group/e mt-8 inline-flex items-center gap-2 font-display text-[15px] text-oro-luz';
---

<Base title="" description={site.descripcion}>
  <Campo />

  <!-- Hilo de oro: progreso lateral con la Δ bajando -->
  <div class="fixed right-6 top-1/2 z-40 hidden h-[36vh] w-px -translate-y-1/2 bg-linea lg:block" aria-hidden="true">
    <span class="absolute -left-[5px] block transition-[top] duration-150" data-rail><Delta class="block h-[11px] text-oro-luz" /></span>
  </div>

  <!-- 1 · Hero -->
  <section class="flex min-h-[100svh] flex-col justify-end" data-panel data-hero>
    <div class="wrap sombra-texto pb-20 md:pb-24" data-cont>
      <h1 class="max-w-[13ch] font-display text-[clamp(44px,8.6vw,124px)] font-extralight leading-[0.98] tracking-[-0.04em]">
        Aplicamos la IA para <span class="font-semibold text-oro-luz">ahorrar costes</span> a tu empresa.
      </h1>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <Boton href={href('/contacto/')}>Reservar diagnóstico</Boton>
        <p class="flex items-center gap-2 font-display text-[15px] text-pizarra"><Delta class="h-[0.7em] text-oro-luz" /> Consultora de IA para pymes · {site.ciudad}</p>
      </div>
      <a href={href('/servicios/#cupo')} class="group/c mt-8 inline-flex items-center gap-3 rounded-full border border-oro-luz/40 bg-tinta/70 px-4 py-2 font-display text-[14px] text-marfil/90 backdrop-blur-sm transition-colors hover:border-oro-luz">
        <Icono nombre="euro" class="h-4 w-4 text-oro-luz" />
        Proveedor acreditado del Cupó IA: hasta 8.000 € subvencionados por la Generalitat
        <Icono nombre="flecha" class="h-4 w-4 text-oro-luz transition-transform group-hover/c:translate-x-1" />
      </a>
    </div>
  </section>

  <!-- 2 · Medir -->
  <section class="flex min-h-[100svh] items-center" data-panel>
    <div class="wrap sombra-texto flex justify-end" data-cont>
      <div class="md:w-1/2">
        <Marcador n="01" texto="Diagnóstico" />
        <h2 class:list={[h2, 'mt-5']}>Primero medimos dónde estás.</h2>
        <p class={linea}>Treinta minutos, gratis. Te decimos dónde la IA ahorra horas en tu empresa y dónde no.</p>
        <a href={href('/servicios/#diagnostico')} class={enlace}>Cómo es el diagnóstico <Icono nombre="flecha" class="h-4 w-4 transition-transform group-hover/e:translate-x-1" /></a>
      </div>
    </div>
  </section>

  <!-- 3 · Construir -->
  <section class="flex min-h-[100svh] items-center" data-panel>
    <div class="wrap sombra-texto" data-cont>
      <div class="md:w-[60%]">
        <Marcador n="02" texto="Transformación" />
        <h2 class:list={[h2, 'mt-5']}>Construimos hasta que entra en producción.</h2>
      </div>
      <ul class="mt-12 grid max-w-[900px] gap-px overflow-hidden rounded-[4px] border border-linea bg-linea md:grid-cols-3" role="list">
        {
          pasos.map((p) => (
            <li class="bg-tinta/80 p-6 backdrop-blur-sm [text-shadow:none]">
              <span class="grid h-12 w-12 place-items-center rounded-[6px] bg-oro/10 text-oro-luz"><Icono nombre={p.icono} class="h-7 w-7" /></span>
              <p class="mt-4 font-display text-[18px] text-marfil">{p.nombre}</p>
              <p class="mt-1.5 text-[14px] text-pizarra">{p.texto}</p>
            </li>
          ))
        }
      </ul>
      <a href={href('/servicios/#transformacion')} class={enlace}>Las cuatro fases <Icono nombre="flecha" class="h-4 w-4 transition-transform group-hover/e:translate-x-1" /></a>
    </div>
  </section>

  <!-- 4 · Medir otra vez · cifras -->
  <section class="relative h-[280vh]" data-panel data-cifras>
    <div class="sticky top-0 flex h-[100svh] items-center bg-oro/[0.06] sombra-texto" data-cont>
      <div class="wrap w-full">
        <Marcador n="03" texto="Resultados" />
        <p class="mt-3 font-display text-[clamp(18px,2vw,26px)] text-pizarra">Después medimos otra vez.</p>
        <div class="relative mt-4 h-[54vh]">
          {
            cifras.map((c, i) => (
              <article class="absolute inset-0 flex flex-col justify-center" data-cifra={i} style={i === 0 ? '' : 'opacity:0'}>
                <p class="inline-flex w-fit items-center gap-2 rounded-full border border-oro-luz/40 px-3 py-1 font-display text-[13px] text-marfil/85">
                  <Icono nombre={c.icono} class="h-4 w-4 text-oro-luz" />
                  {c.meta}
                </p>
                <p class="mt-4 font-display text-[clamp(100px,22vw,320px)] font-extralight leading-[0.9] tracking-[-0.06em] text-marfil">
                  <span data-num={c.valor}>{c.valor}</span><span class="text-oro-luz">{c.sufijo}</span>
                </p>
                <p class="mt-5 max-w-[26ch] font-display text-[clamp(20px,2.6vw,34px)] font-normal leading-tight text-pizarra">{c.frase}</p>
                <a href={href(`/historias-de-exito/${c.historia}/`)} class={enlace.replace('mt-8', 'mt-6')}>Leer el caso <Icono nombre="flecha" class="h-4 w-4 transition-transform group-hover/e:translate-x-1" /></a>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · Sectores -->
  <section class="flex min-h-[100svh] items-center py-24" data-panel>
    <div class="wrap sombra-texto" data-cont>
      <Marcador n="04" texto="Sectores" />
      <h2 class:list={[h2, 'mt-5']}>Seis sectores.<br />Una metodología.</h2>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {
          sectores.map((s) => (
            <li>
              <a
                href={href(`/sectores/${s.slug}/`)}
                class="group block h-full rounded-[4px] border border-linea bg-tinta/85 p-6 backdrop-blur-sm transition-[border-color,transform] duration-300 textura-delta [text-shadow:none] hover:-translate-y-1 hover:border-oro-luz/70"
              >
                <span class="grid h-12 w-12 place-items-center rounded-[6px] bg-oro/10 text-oro-luz"><Icono nombre={s.slug as 'clinicas'} class="h-7 w-7" /></span>
                <p class="mt-5 font-display text-[20px] leading-tight text-marfil">{s.nombre}</p>
                <p class="mt-2 text-[14px] leading-snug text-pizarra">{s.resumen}</p>
                <span class="mt-5 inline-flex items-center gap-1.5 font-display text-[13px] text-oro-luz opacity-0 transition-opacity group-hover:opacity-100">Ver el sector <Icono nombre="flecha" class="h-3.5 w-3.5" /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6 · Productos · ventanas -->
  <section class="relative h-[240vh]" data-panel data-productos>
    <div class="sticky top-0 flex h-[100svh] flex-col justify-start overflow-hidden pt-[10vh] sombra-texto" data-cont>
      <div class="wrap">
        <Marcador n="05" texto="Productos propios" />
        <h2 class="mt-5 font-display text-[clamp(32px,4.8vw,68px)] font-extralight leading-[1] tracking-[-0.035em] text-marfil">Construimos lo que implantamos.</h2>
        <p class="mt-4 max-w-[40ch] font-display text-[clamp(16px,1.4vw,20px)] text-marfil/75">Productos en producción con clientes reales. Nuestro laboratorio.</p>
      </div>
      <div class="mt-8 flex w-max gap-8 pl-[max(24px,calc((100vw-1120px)/2))] [perspective:1400px]" data-tira>
        {
          capturas.map((c) => (
            <a href={href(`/productos/#${c.slug}`)} class="group block w-[min(66vw,600px)] shrink-0 [transform:rotateY(-6deg)] transition-transform duration-500 hover:[transform:rotateY(0deg)]">
              <div class="overflow-hidden rounded-[8px] border border-linea bg-tinta-honda [text-shadow:none] shadow-[0_40px_90px_-30px_rgba(0,0,0,.9)] transition-[border-color,transform] duration-500 group-hover:-translate-y-1 group-hover:border-oro-luz/70">
                <div class="flex items-center gap-1.5 border-b border-linea px-3.5 py-2.5">
                  <span class="h-2 w-2 rounded-full bg-linea" /><span class="h-2 w-2 rounded-full bg-linea" /><span class="h-2 w-2 rounded-full bg-linea" />
                  <span class="ml-3 rounded-[3px] bg-tinta px-2.5 py-0.5 font-mono text-[11px] text-pizarra">{c.url}</span>
                  <Delta class="ml-auto h-2.5 text-oro/70" />
                </div>
                <Image src={c.img} alt={`Web de ${c.nombre}`} width={1200} format="webp" quality={78} class="w-full" loading="lazy" />
              </div>
              <p class="mt-4 font-display text-[18px] text-marfil">{c.nombre} <span class="text-pizarra">· {c.que}</span></p>
            </a>
          ))
        }
        <a href={href('/productos/')} class="flex w-[40vw] shrink-0 items-center gap-3 font-display text-[clamp(20px,2.4vw,32px)] text-marfil/80 hover:text-oro-luz">Los siete productos <Icono nombre="flecha" class="h-6 w-6" /></a>
      </div>
    </div>
  </section>

  <!-- 7 · Cierre -->
  <section class="relative flex min-h-[100svh] items-center overflow-hidden bg-oro/[0.06]" data-panel>
    <div class="pointer-events-none absolute -bottom-[6vh] right-[4vw]"><Delta class="block h-[72vh] text-oro/[0.09]" /></div>
    <div class="wrap sombra-texto" data-cont>
      <Marcador n="06" texto="Hablemos" />
      <h2 class="mt-5 font-display text-[clamp(44px,8vw,124px)] font-extralight leading-[0.96] tracking-[-0.045em]">
        30 minutos.<br /><span class="text-pizarra">Sin compromiso.</span>
      </h2>
      <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3" role="list">
        {
          datosCierre.map((d) => (
            <li class="flex items-center gap-2.5 font-display text-[15px] text-marfil/85">
              <Icono nombre={d.icono} class="h-5 w-5 text-oro-luz" />
              {d.texto}
            </li>
          ))
        }
      </ul>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <Boton href={href('/contacto/')}>Reservar diagnóstico</Boton>
        <a href={href('/servicios/')} class="group/e inline-flex items-center gap-2 font-display text-[15px] text-oro-luz">Cómo trabajamos <Icono nombre="flecha" class="h-4 w-4 transition-transform group-hover/e:translate-x-1" /></a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll suavizado.
  if (!reduce) {
    const lenis = new Lenis({ lerp: 0.085, smoothWheel: true });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((t) => lenis.raf(t * 1000));
    gsap.ticker.lagSmoothing(0);
  }

  // Progreso global: escenario 3D y Δ del carril lateral.
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  ScrollTrigger.create({
    start: 0,
    end: () => document.documentElement.scrollHeight - innerHeight,
    onUpdate: (s) => {
      window.__progreso = s.progress;
      if (rail) rail.style.top = `${s.progress * 100}%`;
    },
  });

  // Cada panel entra, se sostiene y sale con el scroll.
  document.querySelectorAll<HTMLElement>('[data-panel]').forEach((sec) => {
    const cont = sec.querySelector<HTMLElement>('[data-cont]');
    if (!cont) return;
    const tl = gsap.timeline({ scrollTrigger: { trigger: sec, start: 'top bottom', end: 'bottom top', scrub: reduce ? false : 0.35 } });
    if (sec.hasAttribute('data-hero')) tl.to({}, { duration: 0.35 });
    else tl.fromTo(cont, { opacity: 0, y: 70 }, { opacity: 1, y: 0, duration: 0.28, ease: 'power2.out' });
    tl.to({}, { duration: 0.42 });
    tl.to(cont, { opacity: 0, y: -70, duration: 0.25, ease: 'power2.in' });
  });

  // Cifras que se suceden dentro de su tramo fijo.
  const cifras = gsap.utils.toArray<HTMLElement>('[data-cifra]');
  if (cifras.length > 1) {
    const tl = gsap.timeline({ scrollTrigger: { trigger: '[data-cifras]', start: 'top top', end: 'bottom bottom', scrub: reduce ? false : 0.5 } });
    cifras.forEach((el, i) => {
      if (i > 0) {
        tl.to(cifras[i - 1], { opacity: 0, y: -50, duration: 0.5, ease: 'power2.in' }, `c${i}`);
        tl.fromTo(el, { opacity: 0, y: 70 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, `c${i}+=0.25`);
      }
      tl.to({}, { duration: 1 });
    });
  }

  // Tira de productos: avanza en horizontal con el scroll.
  const tira = document.querySelector<HTMLElement>('[data-tira]');
  if (tira) {
    gsap.to(tira, {
      x: () => -(tira.scrollWidth - innerWidth + 24),
      ease: 'none',
      scrollTrigger: { trigger: '[data-productos]', start: 'top top', end: 'bottom bottom', scrub: reduce ? false : 0.5, invalidateOnRefresh: true },
    });
  }

  // Números: cuentan la primera vez que se muestran.
  gsap.utils.toArray<HTMLElement>('[data-num]').forEach((el) => {
    const fin = Number(el.dataset.num);
    if (reduce) return;
    const obj = { v: 0 };
    ScrollTrigger.create({
      trigger: el, start: 'top 90%', once: true,
      onEnter: () => gsap.to(obj, { v: fin, duration: 1.2, ease: 'power2.out', onUpdate: () => (el.textContent = String(Math.round(obj.v))) }),
    });
  });
</script>
