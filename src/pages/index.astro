      <a class="logo" href="https://www.hetzner.com" target="_blank" rel="noopener"><img src="/img/logos/hetzner.svg" alt="Hetzner Cloud"></a>
      <a class="logo wide" href="https://huggingface.co" target="_blank" rel="noopener"><img src="/img/logos/huggingface.svg" alt="Hugging Face"></a>
      <a class="logo wide" href="https://mistral.ai" target="_blank" rel="noopener"><img src="/img/logos/mistral.svg" alt="Mistral AI"></a>
