---
import Base from '../../../layouts/Base.astro';
import Cta from '../../../components/Cta.astro';
import { hrefCa as href } from '../../../lib/site';
import { historias } from '../../../data/historias.ca';
---

<Base
  title="Històries d'èxit"
  description="Tres projectes reals amb resultats verificats: 38% menys absències a consulta, 2h recuperades per comercial i dia, 20h alliberades per soci sènior al mes."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>Casos reals</p>
    <h1
      class="mt-7 max-w-[16ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      Tres projectes. <span class="font-semibold text-oro-oscuro">Tres xifres verificables.</span>
    </h1>
    <p class="mt-8 max-w-[58ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      No prometem: mesurem. Cada projecte comença amb una estimació quantificada del retorn i es continua amb
      mètriques verificables mes a mes. Aquests són tres casos reals d'empreses que poden explicar què ha canviat
      després de treballar amb nosaltres.
    </p>
  </section>

  <!-- Las tres historias -->
  <section class="hairline">
    <div class="wrap py-8 md:py-12">
      <ol role="list">
        {
          historias.map((h, i) => (
            <li class="border-b border-linea last:border-b-0">
              <a
                href={href(`/historias-de-exito/${h.slug}/`)}
                class="group grid gap-6 py-14 transition-colors md:grid-cols-12 md:gap-10 md:py-20"
                data-reveal
              >
                <div class="md:col-span-5">
                  <p class="font-display text-[clamp(64px,9vw,128px)] font-extralight leading-none tracking-[-0.04em] text-oro-oscuro">
                    <span data-contador={h.cifra.valor} data-sufijo={h.cifra.sufijo}>{`${h.cifra.valor}${h.cifra.sufijo}`}</span>
                  </p>
                  <p class="mt-3 font-mono text-[12px] uppercase tracking-[0.14em] text-pizarra">{h.etiqueta}</p>
                </div>
                <div class="md:col-span-7">
                  <p class="eyebrow text-pizarra">
                    Història {i + 1} de {historias.length} · {h.sector}
                  </p>
                  <h2 class="mt-4 font-display text-[clamp(22px,2.4vw,30px)] font-semibold leading-[1.2]">
                    {h.cliente}
                  </h2>
                  <p class="mt-5 text-[16px] text-pizarra">{h.resumen}</p>
                  <span class="mt-6 inline-block font-mono text-[12px] text-oro-oscuro group-hover:text-tinta">
                    Llegir el cas complet →
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Enlace a proyectos en curso -->
  <section class="hairline bg-panel">
    <div class="wrap py-16">
      <p class="max-w-[60ch] text-[15px] leading-[1.7] text-pizarra">
        A més d'aquests tres casos tancats, tenim diversos <a
          href={href('/proyectos-en-curso/')}
          class="text-oro-oscuro hover:underline">projectes en curs</a
        >, encara en fase de diagnòstic i sense resultats verificats.
      </p>
    </div>
  </section>

  <Cta
    titulo="Vols ser el quart cas?"
    texto="Diagnòstic de 30 minuts. Et lliurem una proposta personalitzada amb pla de treball i pressupost. Sense compromís."
    boton="Reservar diagnòstic gratuït"
  />
</Base>
