---
import Base from '../../../layouts/Base.astro';
import Cta from '../../../components/Cta.astro';
import { hrefCa as href } from '../../../lib/site';
import { sectores } from '../../../data/sectores.ca';

const descripcion =
  'Treballem amb empreses de sis verticals. En cadascun apliquem una metodologia adaptada al llenguatge, els processos i les prioritats del sector.';
---

<Base title="Sectors" description={descripcion}>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>Sectors</p>
    <h1
      class="mt-7 max-w-[16ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      Sis sectors. Una metodologia contrastada.
    </h1>
    <p class="mt-8 max-w-[56ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      Treballem amb empreses de sis verticals. En cadascun apliquem una metodologia adaptada al llenguatge, els
      processos i les prioritats del sector. La tecnologia és la part visible: el que canvia és com treballa el
      teu equip.
    </p>
  </section>

  <!-- Los seis sectores -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <ul class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {
          sectores.map((s, i) => (
            <li data-reveal>
              <a
                href={href(`/sectores/${s.slug}/`)}
                class="group flex h-full flex-col border-t border-linea pt-6 transition-colors hover:border-oro"
              >
                <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">
                  Sector {String(i + 1).padStart(2, '0')}
                </span>
                <h2 class="mt-4 font-display text-[19px] font-semibold">{s.nombre}</h2>
                <p class="mt-3 flex-1 text-[15px] text-pizarra">{s.resumen}</p>
                <span class="mt-5 inline-block font-mono text-[12px] text-tinta/70 group-hover:text-oro-oscuro">
                  Veure transformació →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Cta
    titulo="No encaixa en un de clar? Parlem-ne."
    texto="La metodologia és la mateixa per a qualsevol sector. El diagnòstic identifica quins processos es transformen i com. Sense compromís."
    boton="Reservar diagnòstic gratuït"
  />
</Base>
