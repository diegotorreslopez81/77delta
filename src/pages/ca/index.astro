<script>
  const slides = document.querySelectorAll<HTMLElement>('.case .slide');
  const dots = document.querySelectorAll<HTMLButtonElement>('.case .dot');
  let actual = 0;
  const ir = (i: number) => {
    actual = (i + slides.length) % slides.length;
    slides.forEach((s, k) => s.classList.toggle('active', k === actual));
    dots.forEach((d, k) => d.classList.toggle('active', k === actual));
  };
  document.querySelector('[data-caso-prev]')?.addEventListener('click', () => ir(actual - 1));
  document.querySelector('[data-caso-next]')?.addEventListener('click', () => ir(actual + 1));
  dots.forEach((d) => d.addEventListener('click', () => ir(Number(d.dataset.casoIr))));
  if (slides.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let timer = setInterval(() => ir(actual + 1), 7000);
    document.querySelector('.case')?.addEventListener('pointerenter', () => clearInterval(timer));
    document.querySelector('.case')?.addEventListener('pointerleave', () => { timer = setInterval(() => ir(actual + 1), 7000); });
  }
</script>
