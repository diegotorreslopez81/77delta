---
/**
 * Inici, versió catalana. Mateixa estructura i estils que src/pages/index.astro;
 * es tradueix el text visible i s'anteposa /ca/ als enllaços interns.
 */
import Base from '../../layouts/Base.astro';
import { site } from '../../lib/site';
import { casos } from '../../data/casos-de-uso';

const familiesCa = [
  { slug: 'conversacional', num: '01', titol: 'Assistents conversacionals' },
  { slug: 'agentes', num: '02', titol: 'Agents autònoms' },
  { slug: 'rag', num: '03', titol: 'Cerca i coneixement' },
  { slug: 'workflow', num: '04', titol: "Automatització de processos" },
  { slug: 'governance', num: '05', titol: 'Governança i compliment' },
  { slug: 'seguridad', num: '06', titol: 'Seguretat d’IA' },
  { slug: 'verticales', num: '07', titol: 'Plataformes verticals i dades sintètiques' },
  { slug: 'modelos', num: '08', titol: 'Models propis i predicció' },
];
const familiesTextCa: Record<string, string> = {
  conversacional: 'Chatbots i assistents de veu per a web, WhatsApp i telèfon, amb cerca sobre la teva informació, escalat a persona i analítica de converses. Atenció al client, salut, formació i suport intern.',
  agentes: 'Agents que executen processos de debò: consulten sistemes interns, responen preguntes de negoci sobre les teves dades, vigilen, proven i fan prospecció. Amb traça completa de cada pas per poder-ho auditar.',
  rag: 'Cerca semàntica sobre la teva intranet, la teva normativa o les teves gravacions. Control d’accés per rol, citació obligatòria de la font a cada resposta i indexació incremental.',
  workflow: 'Integració entre sistemes que no es parlen, gestió d’incidències, comunicació multicanal, informes automàtics i memòries tècniques per a licitacions.',
  governance: 'Governança de sistemes d’IA segons el Reglament Europeu d’IA, auditoria ALTAI i compliment multi-marc amb RGPD, NIS2 i la norma d’accessibilitat. La documentació obligatòria es genera sola.',
  seguridad: 'Auditoria i blindatge dels assistents que ja tens publicats: què se’ls pot treure, com se’ls treu i com es tanca. Inclou proves adversàries, barreres de protecció i vigilància contínua.',
  verticales: 'Plataformes d’IA per a un sector concret (assegurances, legal, sanitat, acceleració empresarial), simulació digital i generació de dades sintètiques que preserven la privacitat.',
  modelos: 'Ajust fi de models oberts per a un vertical, previsió i detecció d’anomalies, classificació supervisada, reconeixement de documents a mida i avaluació de models.',
};
---

<Base title="" description={site.descripcionCa}>
<div class="home">
<!-- HERO -->
<section class="hero">
  <div class="cont">
    <div class="grid">
      <div>
        <div class="pill"><span class="badge"></span>Acreditats per ACCIÓ</div>
        <h1>Apliquem la IA per <em>estalviar costos</em> a la teva empresa.</h1>
        <p class="lead">Consultora tecnològica especialitzada en pimes. Diagnòstic gratuït, transformació operativa amb IA i soci tecnològic.</p>
        <div class="ctas">
          <a href="/ca/contacto/" class="btn-primary">Reservar diagnòstic <span>→</span></a>
          <a href="/ca/servicios/" class="btn-ghost">Veure com treballem</a>
        </div>
      </div>
      <div class="photo">
        <img src="/img/fotos/equipo-1600.webp" alt="Equip professional treballant">
      </div>
    </div>
  </div>
</section>

<!-- PRUEBA SOCIAL -->
<section class="proof">
  <div class="cont">
    <p class="proof-txt">Més de set anys aplicant IA amb criteri, amb institucions i corporacions de primer nivell</p>
    <div class="proof-logos">
      <a href="https://www.accio.gencat.cat" target="_blank" rel="noopener"><img src="/img/logos/accio.png" alt="ACCIÓ" loading="lazy"></a>
      <a href="https://www.gencat.cat" target="_blank" rel="noopener"><img src="/img/logos/gencat.svg" alt="Generalitat de Catalunya" loading="lazy"></a>
      <a href="https://www.bancsabadell.com" target="_blank" rel="noopener"><img src="/img/logos/sabadell.png" alt="Banc Sabadell" loading="lazy"></a>
      <a href="https://futurium.ec.europa.eu" target="_blank" rel="noopener"><img src="/img/logos/futurium.svg" alt="Comissió Europea" loading="lazy"></a>
      <a href="https://i2cat.net" target="_blank" rel="noopener"><img src="/img/logos/i2cat.svg" alt="i2CAT" loading="lazy"></a>
      <a href="https://barcelonactiva.cat" target="_blank" rel="noopener"><img src="/img/logos/barcelona-activa.png" alt="Barcelona Activa" loading="lazy"></a>
      <a href="https://aws.amazon.com" target="_blank" rel="noopener"><img src="/img/logos/aws.svg" alt="Amazon Web Services" loading="lazy"></a>
    </div>
    <a href="#confianza" class="proof-mas">Veure totes les organitzacions <span>&#8594;</span></a>
  </div>
</section>

<section class="problem">
  <div class="cont">
    <div class="grid">
      <div class="photo">
        <img src="/img/fotos/gerente-1600.webp" alt="Gerent de pime revisant informes">
      </div>
      <div>
        <span class="section-tag">El problema</span>
        <h2>La intel·ligència artificial està reordenant el teu sector. <em>La pregunta no és si t’afectarà, sinó com aplicar-la bé.</em></h2>
        <p class="lead">La informació disponible és abundant, però distingir el que realment transforma el teu negoci del que només sona interessant requereix criteri i experiència. La transformació no és només tecnològica: toca processos, equips i formes de decidir.</p>
        <p class="questions">Quines tasques repetitives consumeixen el dia a dia del teu equip? Quines decisions es prenen sense dades suficients? Quines àrees estan saturades? Què passa quan una persona clau no hi és? Quina és la inversió real per començar i com es mesura el retorn?</p>
      </div>
    </div>
  </div>
</section>

<!-- SERVICIOS -->
<section class="services" id="servicios">
  <div class="cont">
    <div class="section-head">
      <span class="section-tag">Com treballem</span>
      <h2>Comencem per un diagnòstic. Després, tu decideixes el recorregut.</h2>
      <p>Cada empresa és diferent. El procés és lineal: primer entenem la teva realitat, després construïm la transformació i, si vols, t’acompanyem a mitjà i llarg termini com el teu soci tecnològic.</p>
    </div>

    <div class="svc-featured">
      <img src="/img/fotos/diagnostico-1600.webp" alt="Diagnòstic inicial">
      <div class="content">
        <div class="text-panel">
          <span class="badge">PRIMER PAS · GRATUÏT · 30 MIN</span>
          <h3>Diagnòstic</h3>
          <p>30 minuts d’entrevista estructurada i un formulari que ens permet entendre la teva realitat. Reps una proposta personalitzada amb l’estat inicial de la teva empresa, pla de treball i pressupost. Sense compromís.</p>
          <a href="/ca/servicios/diagnostico/" class="arrow-btn">Veure el diagnòstic <span>→</span></a>
        </div>
      </div>
    </div>

    <div class="svc-grid">
      <a href="/ca/servicios/transformacion/" class="svc-card">
        <div class="num">02 · Projecte a mida</div>
        <h3>Transformació operativa amb IA</h3>
        <p>Després del diagnòstic, executem la proposta acordada: implantació, integració amb els teus sistemes, automatització de processos i capacitació del teu equip. Tot el que necessita la transformació. La inversió es defineix a la proposta, ajustada a l’abast.</p>
        <div class="price"><span>Cotització personalitzada a la proposta</span><span class="arrow">→</span></div>
      </a>
      <a href="/ca/servicios/partner/" class="svc-card">
        <div class="num">03 · Mensualitat</div>
        <h3>Soci tecnològic</h3>
        <p>Acompanyament continu en la direcció estratègica d’IA de la teva empresa. Revisem propostes de proveïdors, participem en decisions tecnològiques i identifiquem noves oportunitats cada mes. Tres paquets d’hores amb descompte per volum.</p>
        <div class="price"><span>Des de 1.000 €/mes · 6 mesos mínim</span><span class="arrow">→</span></div>
      </a>
    </div>
  </div>
</section>

<!-- SEGURIDAD DE IA -->
<section class="aisec" id="seguridad">
  <div class="cont">
    <div class="aisec-grid">
      <div>
        <span class="section-tag">Seguretat d’IA</span>
        <h2>El teu chatbot <em>explica més del que et penses.</em></h2>
        <p>Posar un assistent amb IA a la web porta una tarda. Auditar-lo no ho fa gairebé ningú. El provem com el provaria algú amb males intencions i et mostrem què se li escapa: les instruccions internes, els preus que no hauria de donar, les dades de clients a què arriba i el que diu quan algú el treu de guió.</p>
        <p class="aisec-nota">Ho fem amb LeakAI, l’eina que hem construït per a això. Amb ella vam rastrejar 391 webs espanyoles el setembre de 2026 i seguim auditant a fons els assistents amb IA que hem trobat. El diagnòstic és gratuït. El que es paga és deixar-ho tancat.</p>
        <p class="aisec-nota"><a href="/ca/estudio-asistentes-ia/" class="aisec-enlace">Veure l’estudi amb les dades &#8594;</a></p>
        <div class="ctas">
          <a href="/ca/servicios/seguridad-ia/" class="btn-primary">Demanar l’escaneig gratuït <span>&#8594;</span></a>
          <a href="/ca/productos/#leakai" class="btn-ghost">Conèixer LeakAI</a>
        </div>
      </div>

      <aside class="aisec-informe" aria-label="Exemple d’informe bàsic">
        <div class="aisec-informe-cab">
          <span>Informe bàsic</span>
          <span class="aisec-ejemplo">Exemple</span>
        </div>
        <ul>
          <li><span class="q">Extracció d’instruccions</span><span class="s s3">Crític</span></li>
          <li><span class="q">Preus i condicions</span><span class="s s2">Alt</span></li>
          <li><span class="q">Dades de clients</span><span class="s s1">Mitjà</span></li>
          <li><span class="q">Injecció d’instruccions</span><span class="s s2">Alt</span></li>
          <li><span class="q">Sortida de guió</span><span class="s s1">Mitjà</span></li>
        </ul>
        <p class="aisec-pie">Cada troballa s’acompanya del fragment exacte de la conversa que ho demostra.</p>
      </aside>
    </div>
  </div>
</section>

<!-- SECTORES -->
<section class="sectors" id="sectores">
  <div class="cont">
    <div class="section-head">
      <span class="section-tag">Sectors</span>
      <h2>Sis sectors. Una metodologia.</h2>
      <p>A cadascun apliquem una metodologia contrastada. La tecnologia és la part visible. El que canvia és com treballa el teu equip.</p>
    </div>
    <div class="sec-grid">
      <a href="/ca/sectores/clinicas/" class="sec-card">
        <img src="/img/fotos/clinicas-900.webp" alt="Clíniques">
        <div class="content">
          <div class="num">Sector 01</div>
          <h3>Clíniques i centres de salut</h3>
          <p>Repensem la recepció, l’agenda, el seguiment del pacient i la traçabilitat clínica.</p>
          <span class="arrow">Veure casos del sector →</span>
        </div>
      </a>
      <a href="/ca/sectores/industria/" class="sec-card">
        <img src="/img/fotos/industria-900.webp" alt="Indústria">
        <div class="content">
          <div class="num">Sector 02</div>
          <h3>Indústria i tallers</h3>
          <p>Transformem el cicle de pressupost, manteniment i control de qualitat de processos productius.</p>
          <span class="arrow">Veure casos del sector →</span>
        </div>
      </a>
      <a href="/ca/sectores/distribucion/" class="sec-card">
        <img src="/img/fotos/distribucion-900.webp" alt="Distribució">
        <div class="content">
          <div class="num">Sector 03</div>
          <h3>Distribució i logística</h3>
          <p>Repensem com es reben les comandes, com es valida l’estoc i com treballen els comercials.</p>
          <span class="arrow">Veure casos del sector →</span>
        </div>
      </a>
      <a href="/ca/sectores/despachos/" class="sec-card">
        <img src="/img/fotos/despachos-900.webp" alt="Despatxos">
        <div class="content">
          <div class="num">Sector 04</div>
          <h3>Despatxos professionals</h3>
          <p>Alliberem hores del personal sènior automatitzant documents repetitius i cerques sobre arxiu.</p>
          <span class="arrow">Veure casos del sector →</span>
        </div>
      </a>
      <a href="/ca/sectores/administracion/" class="sec-card">
        <img src="/img/fotos/administracion-900.webp" alt="Administració pública">
        <div class="content">
          <div class="num">Sector 05</div>
          <h3>Administració pública</h3>
          <p>Transformem l’atenció ciutadana, la gestió documental i l’anàlisi d’expedients històrics.</p>
          <span class="arrow">Veure casos del sector →</span>
        </div>
      </a>
      <a href="/ca/sectores/formacion/" class="sec-card">
        <img src="/img/fotos/formacion-900.webp" alt="Formació">
        <div class="content">
          <div class="num">Sector 06</div>
          <h3>Formació i recursos humans</h3>
          <p>Canviem com s’avalua, com es fa l’acollida i com s’analitza el progrés de l’alumne.</p>
          <span class="arrow">Veure casos del sector →</span>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- CAPACIDADES -->
<section class="caps" id="capacidades">
  <div class="cont">
    <div class="section-head">
      <span class="section-tag">Què sabem fer</span>
      <h2>{casos.length} capacitats catalogades, en vuit famílies.</h2>
      <p>Dels assistents conversacionals a la seguretat d’IA, passant per agents, cerca sobre la teva documentació, automatització de processos, compliment europeu i models propis. Totes estan en producció en algun lloc. Els exemples són representatius i estan anonimitzats.</p>
    </div>
    <ul class="caps-grid">
      {
        familiesCa.map((f) => (
          <li>
            <a href={`/ca/casos-de-uso/?familia=${f.slug}`}>
              <span class="num">{f.num}</span>
              <h3>{f.titol}</h3>
              <p>{familiesTextCa[f.slug]}</p>
              <span class="cuenta">{casos.filter((c) => c.familia === f.slug).length} capacitats</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/ca/casos-de-uso/" class="caps-link">Veure el catàleg complet i filtrar-lo <span>&#8594;</span></a>
  </div>
</section>

<section class="case" id="casos">
  <div class="slides">

    <!-- Slide 1 · Clínicas dentales -->
    <div class="slide active" data-slide="0">
      <img class="bg" src="/img/fotos/clinicas-1600.webp" alt="Clínica moderna">
      <div class="content"><div class="cont"><div class="grid">
        <div>
          <div class="big">38<span class="pct">%</span></div>
          <div class="label">menys absències a consulta</div>
        </div>
        <div>
          <span class="section-tag">Cas 1 de 5 · Clíniques dentals · Barcelona</span>
          <h3>Tres clíniques dentals compartien el mateix problema.</h3>
          <p>Un nombre elevat de pacients no acudia a les cites sense avís previ. La recepció no disposava del temps necessari per a les trucades de confirmació.</p>
          <p>En quatre setmanes vam implantar Contestia, una recepcionista virtual per WhatsApp. La inversió es va amortitzar en menys d’un mes.</p>
          <a href="/ca/historias-de-exito/clinicas-dentales-barcelona/" class="arrow-btn">Llegir el cas complet <span>→</span></a>
        </div>
      </div></div></div>
    </div>

    <!-- Slide 2 · Distribuidora industrial -->
    <div class="slide" data-slide="1">
      <img class="bg" src="/img/fotos/distribucion-1600.webp" alt="Distribuïdora industrial">
      <div class="content"><div class="cont"><div class="grid">
        <div>
          <div class="big">2<span class="pct">h</span></div>
          <div class="label">recuperades per comercial / dia</div>
        </div>
        <div>
          <span class="section-tag">Cas 2 de 5 · Distribució industrial · Catalunya</span>
          <h3>12 comercials perdien dues hores diàries en comandes manuals.</h3>
          <p>Les comandes arribaven per WhatsApp, trucada i correu. Els comercials dedicaven les dues primeres hores del dia a transcriure-les a l’ERP.</p>
          <p>Vam connectar un assistent d’IA al WhatsApp principal: identifica el client, reconeix referències, valida estoc i genera la comanda. El comercial només intervé en excepcions.</p>
          <a href="/ca/historias-de-exito/distribuidora-industrial/" class="arrow-btn">Llegir el cas complet <span>→</span></a>
        </div>
      </div></div></div>
    </div>

    <!-- Slide 3 · Despacho de abogados -->
    <div class="slide" data-slide="2">
      <img class="bg" src="/img/fotos/despachos-1600.webp" alt="Despatx d'advocats">
      <div class="content"><div class="cont"><div class="grid">
        <div>
          <div class="big">20<span class="pct">h</span></div>
          <div class="label">alliberades per soci sènior / mes</div>
        </div>
        <div>
          <span class="section-tag">Cas 3 de 5 · Dret mercantil · Madrid</span>
          <h3>Un despatx de 18 professionals repetia cinc plantilles de contractes.</h3>
          <p>Cada soci sènior dedicava entre 4 i 6 hores setmanals a redactar i revisar contractes que eren variacions de les mateixes plantilles.</p>
          <p>Vam desenvolupar un generador de contractes basat en les seves plantilles. El temps mitjà de resposta a clients va passar de 3 dies a 6 hores.</p>
          <a href="/ca/historias-de-exito/despacho-mercantil/" class="arrow-btn">Llegir el cas complet <span>→</span></a>
        </div>
      </div></div></div>
    </div>

    <!-- Slide 4 · Taller industrial -->
    <div class="slide" data-slide="3">
      <img class="bg" src="/img/fotos/industria-1600.webp" alt="Taller industrial">
      <div class="content"><div class="cont"><div class="grid">
        <div>
          <div class="big">45<span class="pct">%</span></div>
          <div class="label">menys temps en pressupostos</div>
        </div>
        <div>
          <span class="section-tag">Cas 4 de 5 · Indústria metal·lúrgica · Sabadell</span>
          <h3>Cada pressupost industrial es retardava 3 dies a l’oficina tècnica.</h3>
          <p>El client enviava plànols per correu. L’oficina tècnica calculava materials, mà d’obra i marges a mà. El pressupost trigava 3 dies a sortir.</p>
          <p>Vam implantar un sistema d’IA que interpreta el plànol, calcula l’estimació i proposa marges. L’equip revisa i aprova. Termini: 4 hores.</p>
          <a href="/ca/sectores/industria/" class="arrow-btn">Veure el sector <span>→</span></a>
        </div>
      </div></div></div>
    </div>

    <!-- Slide 5 · Centro formación -->
    <div class="slide" data-slide="4">
      <img class="bg" src="/img/fotos/formacion-1600.webp" alt="Centre de formació">
      <div class="content"><div class="cont"><div class="grid">
        <div>
          <div class="big">3<span class="pct">x</span></div>
          <div class="label">més alumnes atesos en tutoria</div>
        </div>
        <div>
          <span class="section-tag">Cas 5 de 5 · Formació professional · València</span>
          <h3>Un centre de FP tenia cua d’un mes per a tutories personalitzades.</h3>
          <p>Els formadors no donaven l’abast amb els dubtes individuals. Els alumnes esperaven fins a un mes per a una tutoria, cosa que afectava la taxa d’aprovat.</p>
          <p>Vam construir un assistent formatiu entrenat amb el seu material. Resol dubtes 24/7 i escala a tutor humà només en casos complexos. La cua es va eliminar.</p>
          <a href="/ca/sectores/formacion/" class="arrow-btn">Veure el sector <span>→</span></a>
        </div>
      </div></div></div>
    </div>

  </div>

  <button class="nav-btn prev" aria-label="Cas anterior" data-caso-prev>‹</button>
  <button class="nav-btn next" aria-label="Cas següent" data-caso-next>›</button>

  <div class="dots">
    <button class="dot active" data-caso-ir="0" aria-label="Cas 1"></button>
    <button class="dot" data-caso-ir="1" aria-label="Cas 2"></button>
    <button class="dot" data-caso-ir="2" aria-label="Cas 3"></button>
    <button class="dot" data-caso-ir="3" aria-label="Cas 4"></button>
    <button class="dot" data-caso-ir="4" aria-label="Cas 5"></button>
  </div>
</section>

<!-- POR QUÉ 77 DELTA -->
<section class="why">
  <div class="cont">
    <div class="section-head">
      <span class="section-tag">Per què 77 Delta</span>
      <h2>Sis raons per confiar en nosaltres</h2>
    </div>
    <div class="why-grid">
      <div class="why-item">
        <div class="icon">01</div>
        <h3>Transformació transversal, no només tecnologia</h3>
        <p>La IA canvia processos, equips i formes de decidir. No n’hi ha prou amb instal·lar eines. Acompanyem la transformació completa de la teva organització.</p>
      </div>
      <div class="why-item">
        <div class="icon">02</div>
        <h3>La IA augmenta les persones, no les substitueix</h3>
        <p>Dissenyem cada implantació amb el teu equip al centre. Human-in-the-loop per defecte: alliberem temps de tasques repetitives perquè la teva gent es dediqui al que aporta valor.</p>
      </div>
      <div class="why-item">
        <div class="icon">03</div>
        <h3>Construïm el que implantem</h3>
        <p>Operem productes propis en producció amb empreses reals. La tecnologia que proposem està validada amb clients actius.</p>
      </div>
      <div class="why-item">
        <div class="icon">04</div>
        <h3>Dades a Europa, compliment garantit</h3>
        <p>Infraestructura pròpia a la UE. Compliment del RGPD. Sense dependències de tercers països. Suport en català i castellà.</p>
      </div>
      <div class="why-item">
        <div class="icon">05</div>
        <h3>Resultats mesurats en hores i en vendes</h3>
        <p>Cada projecte comença amb una estimació quantificada: temps recuperat, reducció de costos, augment de producció o vendes. Seguiment mensual amb mètriques verificables.</p>
      </div>
      <div class="why-item">
        <div class="icon">06</div>
        <h3>Sense dependència tecnològica</h3>
        <p>En finalitzar el projecte, la teva empresa conserva el codi, les claus, les dades i la documentació. Independència real.</p>
      </div>
    </div>
  </div>
</section>

<!-- SOBRE NOSOTROS PREVIEW -->
<section class="about" id="sobre">
  <div class="cont">
    <div class="grid">
      <div>
        <span class="section-tag">Sobre nosaltres</span>
