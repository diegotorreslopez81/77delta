<style>
  .home{
    --paper:#F3EEE4; --white:#FAF7F0; --ink:#0A1628; --ink-2:#26354D; --ink-3:#5C6879; --ink-4:#9AA3B0;
    --accent:#A7781B; --accent-2:#8A6216; --accent-luz:#D4A03A; --accent-soft:rgba(167,120,27,.12); --accent-glow:rgba(167,120,27,.30);
    --line:rgba(10,22,40,.10); --line-strong:rgba(10,22,40,.18); --dark:#06101F; --ease:cubic-bezier(.2,.7,.2,1);
