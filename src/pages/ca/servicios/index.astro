---
import Base from '../../../layouts/Base.astro';
import Cta from '../../../components/Cta.astro';
import { hrefCa as href, site } from '../../../lib/site';
import { resumen, recorrido, faq } from '../../../data/servicios.ca';
---

<Base
  title="Serveis"
  description="Diagnòstic gratuït, transformació operativa amb IA, soci tecnològic i auditoria de seguretat d'assistents. Quatre formes de treballar amb 77 Delta per reduir costos i augmentar la producció de la teva empresa."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>Serveis</p>
    <h1
      class="mt-7 max-w-[20ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      Quatre formes de treballar amb tu. Un mateix objectiu: <span class="font-semibold text-oro-oscuro"
        >reduir costos</span
      > i augmentar la teva producció amb IA aplicada, sense obrir riscos pel camí.
    </h1>
    <p class="mt-8 max-w-[52ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      Cada empresa és diferent. Per això comencem sempre pel diagnòstic. A partir d’aquí, tu decideixes el
      recorregut: projecte puntual, acompanyament continu o tots dos. Sense tarifes tancades. Sense compromís
      inicial.
    </p>

    <div class="mt-16 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-4">
      {
        resumen.map((r) => (
          <a
            href={href(r.ruta)}
            class="group flex flex-col bg-panel p-8 transition-colors hover:bg-oro/5 md:p-10"
            data-reveal
          >
            <span class="eyebrow text-pizarra">{r.etiqueta}</span>
            <h2 class="mt-4 font-display text-[22px] font-semibold">{r.titulo}</h2>
            <p class="mt-3 flex-1 text-[15px] text-pizarra">{r.pie}</p>
            <span class="mt-8 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">Veure el detall →</span>
          </a>
        ))
      }
    </div>

    <p class="mt-8 max-w-[60ch] font-mono text-[12px] leading-[1.7] text-pizarra" data-reveal>
      Pots començar per un i sumar l’altre quan el necessitis. O combinar-los des de l’inici.
    </p>
  </section>

  <!-- 04 · Seguridad de IA -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-7" data-reveal>
          <p class="eyebrow text-oro-luz">04 · Seguretat</p>
          <p class="eyebrow mt-6 text-marfil/50">Escaneig gratuït · remediació cotitzada</p>
          <h2
            class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]"
          >
            Auditoria dels assistents amb IA que ja tens publicats.
          </h2>
          <p class="mt-6 max-w-[56ch] text-[17px] text-marfil/72">
            Un chatbot amb IA a la teva web parla en el teu nom i sol saber més del que li convé explicar. Provem
            el teu com ho faria algú amb males intencions, et mostrem què se li escapa i, si vols, el deixem
            tancat. El diagnòstic no costa res.
          </p>
          <a href={href('/servicios/seguridad-ia/')} class="mt-8 inline-flex items-center gap-2 font-display text-[15px] text-oro-luz">
            Veure com ho auditem →
          </a>
        </div>
        <ul class="grid gap-4 self-center md:col-span-5" role="list" data-reveal>
          {
            [
              ['Instruccions', 'el system prompt i el que el bot té prohibit dir'],
              ['Condicions', 'preus, descomptes i marges que surten si s’insisteix'],
              ['Dades', 'informació de clients a què l’assistent arriba'],
              ['Guió', 'injecció d’instruccions i respostes fora de control'],
            ].map(([campo, texto]) => (
              <li class="flex items-baseline gap-4 rounded-[4px] border border-marfil/12 bg-marfil/[0.04] px-5 py-4">
                <span class="shrink-0 whitespace-nowrap font-mono text-[11px] uppercase tracking-[0.14em] text-oro-luz">{campo}</span>
                <span class="text-[14px] text-marfil/70">{texto}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="cupo" class="hairline scroll-mt-[68px] bg-oro/[0.06]">
    <div class="wrap grid gap-10 py-20 md:grid-cols-12 md:py-24">
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow">Acreditació</p>
        <h2 class="mt-5 font-display text-[clamp(26px,3.2vw,40px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Proveïdor acreditat per ACCIÓ.
        </h2>
        <p class="mt-6 max-w-[58ch] text-[17px] text-pizarra">
          {site.sociedad} figura al registre oficial de proveïdors tecnològics d’ACCIÓ, l’agència de la
          Generalitat de Catalunya per a la competitivitat empresarial. Si la teva empresa opta a alguna de les
          seves ajudes, ho revisem a la conversa inicial.
        </p>
      </div>
      <div class="self-center md:col-span-5" data-reveal>
        <img
          src={href('/img/logos/accio.png')}
          alt="ACCIÓ, Generalitat de Catalunya"
          width="320"
          height="120"
          loading="lazy"
          decoding="async"
          class="h-14 w-auto"
        />
      </div>
    </div>
  </section>

  <!-- El recorrido típico -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">El recorregut típic</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          D’una conversa a la transformació, en passos clars
        </h2>
        <p class="mt-6 text-[17px] text-pizarra">
          Cada empresa avança al seu ritme. No hi ha obligació de passar d’un pas al següent. La decisió és teva a
          cada etapa.
        </p>
      </div>

      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          recorrido.map((p) => (
            <li class="border-t border-linea pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{p.n}</span>
              <h3 class="mt-4 font-display text-[19px] font-semibold">{p.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Preguntes freqüents</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          El que més ens pregunten abans de començar
        </h2>
      </div>

      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Cta
    titulo="El primer pas és una conversa. Sense compromís."
    texto="30 minuts per entendre la teva realitat i orientar-te sobre com aplicar IA a la teva empresa amb criteri."
    boton="Reservar diagnòstic gratuït"
  />
</Base>
