---
import Base from '../../../layouts/Base.astro';
import Boton from '../../../components/Boton.astro';
import Cta from '../../../components/Cta.astro';
import { hrefCa as href } from '../../../lib/site';
import { queIncluye, fases, resumen } from '../../../data/servicios.ca';

const otros = resumen.filter((r) => r.titulo !== 'Transformació operativa');
---

<Base
  title="Transformació operativa amb IA"
  description="Implantació, integració amb els teus sistemes, automatització de processos i capacitació del teu equip. De quatre a dotze setmanes, començant sempre per un pilot controlat."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>
      <a href={href('/servicios/')} class="transition-colors hover:text-tinta">Serveis</a> · 02 · Projecte a mida
    </p>
    <h1
      class="mt-7 max-w-[19ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      Del prototip a <span class="font-semibold text-oro-oscuro">producció</span>, amb el teu equip dins.
    </h1>
    <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      Executem la proposta acordada després del diagnòstic: implantació, integració amb els teus sistemes,
      automatització de processos i capacitació de la gent que ho farà servir. Tot el que necessita una
      transformació que no depengui de nosaltres després.
    </p>

    <div class="mt-14 flex flex-wrap items-center gap-8" data-reveal>
      <div class="rounded-[4px] border border-linea bg-panel px-8 py-6">
        <p class="font-display text-[30px] font-extralight leading-none tracking-[-0.03em] text-oro-oscuro">
          Personalitzat
        </p>
        <p class="mt-3 max-w-[34ch] font-mono text-[12px] leading-[1.6] text-pizarra">
          La inversió es defineix a la proposta, ajustada a l’abast
        </p>
      </div>
      <Boton href={href('/servicios/diagnostico/')}>Començar pel diagnòstic →</Boton>
    </div>
  </section>

  <!-- Para quién y plazo -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-12 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-6" data-reveal>
        <p class="eyebrow">Per a qui és</p>
        <p class="mt-6 text-[17px] text-pizarra">
          Per a empreses que ja han identificat les seves oportunitats al diagnòstic i volen un equip
          especialitzat que les executi. Cobrim des de projectes puntuals fins a transformacions de diversos
          trimestres.
        </p>
      </div>
      <div class="md:col-span-6 md:pl-6" data-reveal>
        <p class="eyebrow">Termini típic</p>
        <p class="mt-6 text-[17px] text-pizarra">
          Entre quatre i dotze setmanes segons l’abast. Sempre comencem per un pilot controlat abans del
          desplegament complet, perquè validis resultats abans de comprometre recursos.
        </p>
      </div>
    </div>
  </section>

  <!-- Qué incluye -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Què inclou</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Sis peces que van sempre juntes.
        </h2>
      </div>
      <ul class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-2 lg:grid-cols-3" role="list">
        {
          queIncluye.map((q, i) => (
            <li data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 font-display text-[19px] font-semibold leading-[1.3]">{q.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{q.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Las cuatro fases -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow text-oro-luz">Com s’executa</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Quatre fases amb un final clar.
        </h2>
        <p class="mt-6 text-[17px] text-marfil/70">
          El projecte s’acaba de debò: amb el codi, les claus i la documentació a casa teva.
        </p>
      </div>
      <ol class="mt-16 grid gap-10 md:grid-cols-4" role="list">
        {
          fases.map((f) => (
            <li class="border-t border-marfil/15 pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-luz">{f.n}</span>
              <h3 class="mt-3 font-display text-[18px] font-semibold leading-[1.3]">{f.titulo}</h3>
              <p class="mt-3 text-[14px] text-marfil/65">{f.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Otros servicios -->
  <section class="hairline bg-panel">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow" data-reveal>Altres formes de treballar</p>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-3" role="list">
        {
          otros.map((o) => (
            <li class="bg-panel" data-reveal>
              <a href={href(o.ruta)} class="group flex h-full flex-col p-8 transition-colors hover:bg-oro/5">
                <span class="eyebrow text-pizarra">{o.etiqueta}</span>
                <h3 class="mt-3 font-display text-[20px] font-semibold">{o.titulo}</h3>
                <p class="mt-2 flex-1 text-[15px] text-pizarra">{o.pie}</p>
                <span class="mt-6 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">Veure el detall →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Cta
    titulo="30 minuts. Sense compromís. Tu decideixes després."
    texto="Entrevista estructurada amb la teva empresa. Et lliurem una proposta personalitzada amb estat inicial, pla de treball i pressupost."
    boton="Reservar diagnòstic gratuït"
  />
</Base>
