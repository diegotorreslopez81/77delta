---
import Base from '../../../layouts/Base.astro';
import Boton from '../../../components/Boton.astro';
import Cta from '../../../components/Cta.astro';
import { hrefCa as href } from '../../../lib/site';
import { queObtienes, resumen } from '../../../data/servicios.ca';

const otros = resumen.filter((r) => r.titulo !== 'Diagnòstic');
---

<Base
  title="Diagnòstic"
  description="Trenta minuts d'entrevista estructurada i una proposta amb l'estat inicial de la teva empresa, pla de treball i pressupost. Gratuït i sense compromís."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>
      <a href={href('/servicios/')} class="transition-colors hover:text-tinta">Serveis</a> · 01 · Punt de partida
    </p>
    <h1
      class="mt-7 max-w-[18ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      <span class="font-semibold text-oro-oscuro">Trenta minuts</span> per saber on la IA t’estalvia hores de
      debò.
    </h1>
    <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      Una entrevista estructurada i un formulari que ens permeten entendre la teva realitat operativa. Reps una
      proposta personalitzada amb l’estat inicial de la teva empresa, el pla de treball i el pressupost.
    </p>

    <div class="mt-14 flex flex-wrap items-center gap-8" data-reveal>
      <div class="rounded-[4px] border border-linea bg-panel px-8 py-6">
        <p class="font-display text-[34px] font-extralight leading-none tracking-[-0.03em] text-oro-oscuro">
          Gratuït
        </p>
        <p class="mt-3 font-mono text-[12px] text-pizarra">30 minuts · sense compromís</p>
      </div>
      <Boton href={href('/contacto/')}>Reservar diagnòstic →</Boton>
    </div>
  </section>

  <!-- Para quién y cómo -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-12 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Per a qui és</p>
        <p class="mt-6 text-[17px] text-pizarra">
          Per a qualsevol empresa que vulgui entendre què li pot aportar la intel·ligència artificial. No importa
          la mida ni el sector. És el primer pas natural abans de qualsevol servei de pagament.
        </p>
      </div>
      <div class="md:col-span-7 md:pl-6" data-reveal>
        <p class="eyebrow">Com és la conversa</p>
        <p class="mt-6 text-[17px] text-pizarra">
          No és una trucada comercial. És una entrevista de descobriment, amb preguntes estructurades sobre el
          teu dia a dia, els teus processos crítics i els teus colls d’ampolla. T’escoltem primer. Després
          t’orientem, encara que la resposta sigui que encara no toca.
        </p>
      </div>
    </div>
  </section>

  <!-- Qué obtienes -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Què n’obtens</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Surts de la conversa amb cinc coses per escrit.
        </h2>
      </div>
      <ol class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-2" role="list">
        {
          queObtienes.map((q, i) => (
            <li data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 font-display text-[19px] font-semibold leading-[1.3]">{q.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{q.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Después -->
  <section class="hairline bg-panel">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow" data-reveal>I després, tu decideixes</p>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-3" role="list">
        {
          otros.map((o) => (
            <li class="bg-panel" data-reveal>
              <a href={href(o.ruta)} class="group flex h-full flex-col p-8 transition-colors hover:bg-oro/5">
                <span class="eyebrow text-pizarra">{o.etiqueta}</span>
                <h3 class="mt-3 font-display text-[20px] font-semibold">{o.titulo}</h3>
                <p class="mt-2 flex-1 text-[15px] text-pizarra">{o.pie}</p>
                <span class="mt-6 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">Veure el detall →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Cta
    titulo="30 minuts. Sense compromís. Tu decideixes després."
    texto="Entrevista estructurada amb la teva empresa. Et lliurem una proposta personalitzada amb estat inicial, pla de treball i pressupost."
    boton="Reservar diagnòstic gratuït"
  />
</Base>
