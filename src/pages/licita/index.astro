---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { href, hrefCa, site } from '../../lib/site';
import panelGeneral from '../../assets/licita/panel-vista-general.png';
import panelFiltro from '../../assets/licita/panel-filtro-cierran-semana.png';

const capacidades = [
  {
    titulo: 'Detecta',
    texto:
      'Rastrea licitaciones publicadas en las 17 comunidades autónomas y en las plataformas europeas (TED), todos los días.',
  },
  {
    titulo: 'Filtra',
    texto:
      'Descarta lo que no encaja con lo que tu empresa sabe hacer y con lo que puede firmar de verdad: solvencia, capacidad, sector.',
  },
  {
    titulo: 'Mastica el pliego',
    texto:
      'Convierte cada pliego en una ficha corta: fecha de cierre, importe, solvencia exigida y el motivo concreto para ir o no ir.',
  },
  {
    titulo: 'Avisa de plazos',
    texto: 'Ningún cierre se pasa por no haberlo visto a tiempo.',
  },
];

const campo =
  'mt-3 w-full rounded-[8px] border border-tinta/15 bg-panel px-4 py-3 font-sans text-[15px] text-tinta transition-colors placeholder:text-pizarra/60 focus:border-oro';
const etiqueta = 'block font-mono text-[11px] uppercase tracking-[0.18em] text-pizarra';
---

<Base
  title="Licita · el motor de licitaciones"
  description="Licita rastrea licitaciones en las 17 comunidades autónomas y en Europa, filtra por lo que tu empresa puede firmar y mastica cada pliego en una ficha con cierre, importe, solvencia y motivo de ir o no ir."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>Licita · para empresas que licitan</p>
    <h1
      class="mt-7 max-w-[20ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      Deja de perder la tarde <span class="font-semibold text-oro-oscuro">leyendo pliegos que no eran para ti</span>.
    </h1>
    <p class="mt-8 max-w-[58ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      Si tu empresa licita, ya conoces el problema: cientos de publicaciones nuevas cada semana, y la mayoría no te
      sirven. Licita las lee todas, se queda con las que puedes firmar de verdad y te dice, de cada una, si merece la
      pena o no antes de que te pongas a redactar.
    </p>
    <div class="mt-12 flex flex-wrap gap-4" data-reveal>
      <a
        href="#solicitar-demo"
        class="inline-flex items-center gap-2 rounded-[10px] bg-oro px-6 py-3.5 font-sans text-[15px] font-semibold text-marfil shadow-[0_6px_24px_rgba(167,120,27,.30)] transition-[background-color,transform] duration-200 hover:-translate-y-px hover:bg-tinta"
      >
        Pedir una demo →
      </a>
      <a href={hrefCa('/licita/')} class="inline-flex items-center gap-2 font-mono text-[12px] text-pizarra hover:text-tinta">
        En català →
      </a>
    </div>
  </section>

  <!-- Qué hace hoy -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Qué hace Licita hoy</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Sin promesas. Esto es lo que hace ahora mismo.
        </h2>
      </div>

      <ol class="mt-16 grid gap-x-12 gap-y-14 md:grid-cols-2" role="list">
        {
          capacidades.map((c, i) => (
            <li class="border-t border-linea pt-6" data-reveal>
              <span class="font-mono text-[12px] text-oro-oscuro">0{i + 1}</span>
              <h3 class="mt-2 font-display text-[20px] font-semibold">{c.titulo}</h3>
              <p class="mt-3 text-[15px] leading-[1.6] text-pizarra">{c.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- El panel real -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">El panel real</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Esto no es una maqueta. Es el panel de hoy, con datos de hoy.
        </h2>
      </div>

      <div class="mt-14 grid gap-8 md:grid-cols-2">
        <figure data-reveal>
          <Image
            src={panelGeneral}
            width={1400}
            format="webp"
            alt="Panel de Licita: listado de licitaciones con cierre, importe, elegibilidad, solvencia y resumen"
            loading="lazy"
            class="w-full rounded-[8px] border border-linea"
          />
          <figcaption class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">
            Vista general: 1.128 licitaciones rastreadas, filtradas por lo que encaja
          </figcaption>
        </figure>
        <figure data-reveal>
          <Image
            src={panelFiltro}
            width={1400}
            format="webp"
            alt="Panel de Licita con el filtro 'Cierran esta semana' activo, con organismos y provincias reales"
            loading="lazy"
            class="w-full rounded-[8px] border border-linea"
          />
          <figcaption class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">
            El preset "Cierran esta semana", con avisos de plazo en rojo
          </figcaption>
        </figure>
      </div>
      <p class="mt-8 max-w-[60ch] font-mono text-[12px] text-pizarra" data-reveal>
        Capturas reales del panel, 8 de septiembre de 2026. En la demo lo vemos completo, en directo.
      </p>
    </div>
  </section>

  <!-- Cómo funciona: te dice si puedes firmarlo -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[68ch]" data-reveal>
        <p class="eyebrow text-pizarra">Cómo funciona</p>
        <h2 class="mt-5 max-w-[24ch] font-display text-[clamp(26px,3.4vw,42px)] font-extralight leading-[1.15] tracking-[-0.03em]">
          El motor te dice si puedes firmarlo <span class="font-semibold text-oro">antes</span> de que pierdas la tarde
          redactándolo.
        </h2>
        <p class="mt-8 text-[17px] leading-[1.7] text-pizarra">
          Una licitación pública de auditoría y protección de datos puede encajar a primera vista por precio y
          objeto. Licita marca el expediente para revisar el pliego completo: si el requisito real es tener en
          plantilla un consultor de protección de datos titular y un suplente, ambos con grado en Derecho y
          certificación DPD acreditada por ENAC, la oferta queda fuera pase lo que pase con el precio. Licita lo
          detecta antes de escribir una sola línea.
        </p>
        <p class="mt-6 text-[17px] leading-[1.7] text-pizarra">
          Es un patrón habitual: requisitos de solvencia técnica que descartan el expediente antes de redactar
          nada. Ese es justo el tiempo que Licita ahorra cuando funciona.
        </p>
      </div>
    </div>
  </section>

  <!-- Cómo es una ficha -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Cómo es una ficha</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Un pliego de 70 páginas, en una ficha que se lee en un minuto.
        </h2>
        <p class="mt-6 text-[16px] text-pizarra">
          Tres fichas ilustrativas, con el formato real del panel: dos decisiones sobre un pliego concreto y un
          patrón de sector. Todas con el motivo exacto, no una etiqueta genérica.
        </p>
      </div>

      <div class="mt-14 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        <div class="overflow-hidden rounded-[8px] border border-linea bg-panel" data-reveal>
          <div class="flex items-start justify-between gap-4 border-b border-linea px-8 py-5">
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Ejemplo ilustrativo</p>
              <h3 class="mt-2 font-display text-[19px] font-semibold">Ajuntament del Vallès Occidental</h3>
              <p class="mt-1 text-[13px] text-pizarra">Renovación del web municipal, diseño, desarrollo y formación</p>
            </div>
            <span class="mt-1 shrink-0 rounded-full bg-oro/15 px-3 py-1 font-mono text-[11px] font-semibold text-oro-oscuro">GO</span>
          </div>
          <dl class="grid grid-cols-2 gap-6 px-8 py-8">
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Cierre</dt>
              <dd class="mt-2 text-[16px] font-semibold text-tinta">10 sep 2026</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Importe</dt>
              <dd class="mt-2 text-[16px] font-semibold text-tinta">Aprox. 15.000 €</dd>
            </div>
          </dl>
          <div class="border-t border-linea px-8 py-6">
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Solvencia exigida</p>
            <p class="mt-2 text-[14px] italic leading-[1.6] text-pizarra">
              "Sin solvencia formal: declaración responsable + 2 proyectos similares en 5 años." Criterios 100%
              automáticos: precio 70%, bolsa de horas 15%, formación 8%, plazo 7%.
            </p>
            <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Motivo de ir</p>
            <p class="mt-2 text-[14px] leading-[1.6] text-tinta">
              Encaje total. Consultoría, UX, desarrollo y formación es justo lo que sabemos hacer, sin certificaciones
              imposibles.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-[8px] border border-linea bg-panel" data-reveal>
          <div class="flex items-start justify-between gap-4 border-b border-linea px-8 py-5">
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Ejemplo ilustrativo</p>
              <h3 class="mt-2 font-display text-[19px] font-semibold">Organismo público estatal</h3>
              <p class="mt-1 text-[13px] text-pizarra">Auditoría, análisis de riesgos y formación en protección de datos</p>
            </div>
            <span class="mt-1 shrink-0 rounded-full bg-tinta/10 px-3 py-1 font-mono text-[11px] font-semibold text-tinta">NO&#8209;GO</span>
          </div>
          <dl class="grid grid-cols-2 gap-6 px-8 py-8">
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Cierre</dt>
              <dd class="mt-2 text-[16px] font-semibold text-tinta">24 sep 2026</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Importe</dt>
              <dd class="mt-2 text-[16px] font-semibold text-tinta">23.891 €</dd>
            </div>
          </dl>
          <div class="border-t border-linea px-8 py-6">
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Solvencia exigida</p>
            <p class="mt-2 text-[14px] italic leading-[1.6] text-pizarra">
              "Declaración de volumen de negocio o, alternativamente, seguro de responsabilidad civil." Esto solo no
              descarta: el seguro es una vía disponible.
            </p>
            <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Motivo real de no ir</p>
            <p class="mt-2 text-[14px] leading-[1.6] text-tinta">
              Personal que no se tiene: consultor DPD titular y suplente, cada uno con grado en Derecho, certificación
              DPD acreditada por ENAC y 3 años de experiencia. No es la solvencia económica lo que descarta.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-[8px] border border-linea bg-panel" data-reveal>
          <div class="flex items-start justify-between gap-4 border-b border-linea px-8 py-5">
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Patrón ilustrativo</p>
              <h3 class="mt-2 font-display text-[19px] font-semibold">Limpieza e higiene profesional</h3>
              <p class="mt-1 text-[13px] text-pizarra">Suministro a entes públicos catalanes</p>
            </div>
            <span class="mt-1 shrink-0 rounded-full bg-oro/15 px-3 py-1 font-mono text-[11px] font-semibold text-oro-oscuro">PATRÓN</span>
          </div>
          <div class="px-8 py-8">
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Lo que detecta el motor</p>
            <p class="mt-2 text-[14px] leading-[1.6] text-pizarra">
              El suministro de productos de limpieza e higiene a entes públicos catalanes es un mercado activo y
              repetitivo, sobre todo en contratos menores (mayoría por debajo de 15.000 €). Diputació de Barcelona,
              Ajuntament de Sabadell, Universitat de Barcelona, consells comarcals y consorcios de servicios
              sociales aparecen una y otra vez.
            </p>
          </div>
          <div class="border-t border-linea px-8 py-6">
            <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">Por qué importa</p>
            <p class="mt-2 text-[14px] leading-[1.6] text-tinta">
              Comprador que repite varias veces al año, importes pequeños, sin solvencia exigida: el perfil de
              oportunidad más accesible para un proveedor de este sector.
            </p>
          </div>
        </div>
      </div>

      <p class="mt-8 max-w-[60ch] font-mono text-[12px] text-pizarra" data-reveal>
        Fichas ilustrativas, con el formato real del panel. En la demo vemos casos reales, en directo.
      </p>
    </div>
  </section>

  <!-- Formulario de demo -->
  <section id="solicitar-demo" class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="grid gap-16 md:grid-cols-12">
        <div class="md:col-span-5" data-reveal>
          <p class="eyebrow">Ver el motor en marcha</p>
          <h2 class="mt-5 font-display text-[clamp(26px,3.2vw,38px)] font-extralight leading-[1.15] tracking-[-0.03em]">
            Veinte minutos. Con tu sector, no con uno genérico.
          </h2>
          <p class="mt-6 text-[16px] text-pizarra">
            Te enseñamos el panel real, con licitaciones de tu propio sector y territorio. Sin coste, sin
            compromiso.
          </p>
        </div>

        <div class="md:col-span-7" data-reveal>
          <form
            id="form-demo-licita"
            action={`mailto:${site.email}`}
            method="post"
            data-destino={site.email}
            data-endpoint={site.formulario}
            class="grid gap-6 sm:grid-cols-2"
            novalidate
          >
            <input type="text" name="web" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <input type="hidden" name="sector" value="Solicitud de demo · Licita" />

            <div>
              <label class={etiqueta} for="nombre">Nombre</label>
              <input class={campo} type="text" id="nombre" name="nombre" autocomplete="name" required />
            </div>
            <div>
              <label class={etiqueta} for="empresa">Empresa</label>
              <input class={campo} type="text" id="empresa" name="empresa" autocomplete="organization" required />
            </div>
            <div>
              <label class={etiqueta} for="email">Email</label>
              <input class={campo} type="email" id="email" name="email" autocomplete="email" required />
            </div>
            <div>
              <label class={etiqueta} for="telefono">Teléfono (opcional)</label>
              <input class={campo} type="tel" id="telefono" name="telefono" autocomplete="tel" />
            </div>
            <div class="sm:col-span-2">
              <label class={etiqueta} for="mensaje">¿En qué sector licitáis?</label>
              <textarea class={campo} id="mensaje" name="mensaje" rows="4" placeholder="Sector, territorio y qué tipo de contratos os interesan"></textarea>
            </div>
            <div class="sm:col-span-2">
              <button
                type="submit"
                class="inline-flex items-center gap-2 whitespace-nowrap rounded-[10px] bg-oro px-6 py-3.5 font-sans text-[15px] font-semibold text-marfil shadow-[0_6px_24px_rgba(167,120,27,.30)] transition-[background-color,transform] duration-200 hover:-translate-y-px hover:bg-tinta disabled:cursor-wait disabled:opacity-60"
              >
                Solicitar demo →
              </button>
              <p id="form-estado" class="mt-5 hidden max-w-[52ch] text-[15px] text-tinta" role="status" aria-live="polite"></p>
              <p class="mt-6 max-w-[52ch] text-[13px] text-pizarra">
                Los datos se tratan en la Unión Europea conforme al RGPD. Más detalle en nuestra
                <a
                  href={href('/politica-privacidad/')}
                  class="text-tinta underline decoration-linea underline-offset-4 transition-colors hover:decoration-oro"
                  >política de privacidad</a
                >.
              </p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#form-demo-licita');
    const estado = document.querySelector<HTMLParagraphElement>('#form-estado');
    const boton = form?.querySelector<HTMLButtonElement>('button[type=submit]');

    const mostrar = (texto: string) => {
      if (!estado) return;
      estado.textContent = texto;
      estado.classList.remove('hidden');
    };

    const leerCampos = (f: HTMLFormElement) => {
      const datos = new FormData(f);
      const leer = (nombre: string) => String(datos.get(nombre) ?? '').trim();
      return {
        nombre: leer('nombre'),
        empresa: leer('empresa'),
        email: leer('email'),
        sector: leer('sector'),
        mensaje: [leer('telefono') ? `Teléfono: ${leer('telefono')}` : '', leer('mensaje')].filter(Boolean).join('\n'),
        web: leer('web'),
        origen: location.pathname,
      };
    };

    const abrirCorreo = (destino: string, c: ReturnType<typeof leerCampos>) => {
      const asunto = `Solicitud de demo · Licita · ${c.empresa}`;
      const cuerpo = [`Nombre: ${c.nombre}`, `Empresa: ${c.empresa}`, `Email: ${c.email}`, '', c.mensaje].join('\n');
      window.location.href = `mailto:${destino}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
    };

    form?.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      const destino = form.dataset.destino ?? '';
      const endpoint = form.dataset.endpoint ?? '';
      const campos = leerCampos(form);

      if (!endpoint) return abrirCorreo(destino, campos);

      if (boton) boton.disabled = true;
      mostrar('Enviando…');
      try {
        const r = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(campos),
        });
        const respuesta = (await r.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (r.ok && respuesta.ok) {
          form.reset();
          mostrar('Recibido. Te escribimos para cuadrar la demo.');
          return;
        }
        if (r.status === 400 || r.status === 429) {
          mostrar(respuesta.error ?? 'No hemos podido enviar el mensaje. Revisa los campos.');
          return;
        }
        throw new Error(`respuesta ${r.status}`);
      } catch {
        mostrar('El envío directo no está disponible ahora mismo: se abre tu programa de correo con el mensaje preparado.');
        abrirCorreo(destino, campos);
      } finally {
        if (boton) boton.disabled = false;
      }
    });
  </script>
</Base>
