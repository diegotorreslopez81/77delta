---
import Base from '../../layouts/Base.astro';
import Boton from '../../components/Boton.astro';
import Cta from '../../components/Cta.astro';
import { href } from '../../lib/site';

const fugas = [
  {
    titulo: 'Las instrucciones internas',
    texto:
      'El system prompt completo: cómo se le ha dicho al bot que se comporte, qué no debe decir y con qué datos trabaja. Es el mapa para todo lo demás.',
  },
  {
    titulo: 'Precios, descuentos y márgenes',
    texto:
      'Rangos de honorarios, condiciones especiales y umbrales de negociación que están en el contexto del bot porque alguien los pegó ahí para que respondiera mejor.',
  },
  {
    titulo: 'Datos de clientes',
    texto:
      'Si el chatbot consulta un CRM, un histórico de pedidos o una base de conocimiento con datos reales, se le puede pedir que hable de ellos.',
  },
  {
    titulo: 'Comportamiento fuera de guion',
    texto:
      'Con una inyección de instrucciones, el bot de tu web puede acabar diciendo lo que decida un tercero. Sale con tu logotipo al lado.',
  },
  {
    titulo: 'Promesas que no puedes cumplir',
    texto:
      'Plazos, garantías y condiciones inventadas sobre la marcha. Un chatbot en tu dominio es tu voz, y lo que afirma tiene efecto frente al cliente.',
  },
  {
    titulo: 'Acceso a herramientas conectadas',
    texto:
      'Cuando el agente puede reservar, consultar o escribir en tus sistemas, la pregunta deja de ser qué cuenta y pasa a ser qué hace.',
  },
];

const pasos = [
  {
    titulo: 'Detección',
    texto:
      'Recorremos tu web como lo haría un visitante y localizamos los asistentes con IA que hay publicados, incluidos los que el equipo de marketing puso sin avisar a sistemas.',
  },
  {
    titulo: 'Pruebas',
    texto:
      'Lanzamos una batería de pruebas de fuga sobre cada asistente: extracción de instrucciones, revelación de condiciones comerciales, datos personales, inyección de instrucciones y salida de guion.',
  },
  {
    titulo: 'Informe',
    texto:
      'Un modelo juez puntúa cada respuesta contra su rúbrica y tiene que citar el fragmento exacto que constituye la fuga. Sin ese fragmento, no lo contamos como hallazgo.',
  },
  {
    titulo: 'Remediación',
    texto:
      'Reescribimos el system prompt, ponemos guardarraíles y filtros de salida, acotamos lo que el agente puede consultar y dejamos pruebas de regresión para que no vuelva a abrirse.',
  },
];

const entregables = [
  {
    etiqueta: 'Gratuito',
    titulo: 'Informe básico',
    texto:
      'Severidad global, categorías de fuga detectadas y un par de ejemplos redactados. Suficiente para saber si tienes un problema y de qué tamaño.',
  },
  {
    etiqueta: 'Con la remediación',
    titulo: 'Informe completo',
    texto:
      'El detalle reproducible de cada hallazgo, con la conversación exacta y la recomendación técnica. Se entrega al contratar el arreglo, no se vende suelto.',
  },
  {
    etiqueta: 'Opcional',
    titulo: 'Vigilancia continua',
    texto:
      'Repetimos el escaneo cada mes. Cambiar el system prompt o añadir una fuente al asistente puede reabrir lo que estaba cerrado.',
  },
];

const normas = [
  {
    norma: 'Reglamento Europeo de IA',
    texto:
      'Obliga a gestionar el riesgo de los sistemas de IA y a ser transparente con el usuario sobre que habla con una máquina. Un asistente que se sale de guion es un riesgo sin gestionar.',
  },
  {
    norma: 'RGPD',
    texto:
      'Si el asistente puede revelar datos personales de clientes o empleados, eso es una brecha de seguridad con obligación de notificación.',
  },
  {
    norma: 'NIS2',
    texto:
      'Para entidades esenciales e importantes, el chatbot es superficie de exposición pública y entra en la gestión de riesgos de la cadena de suministro digital.',
  },
];
---

<Base
  title="Seguridad de IA"
  description="Auditamos los chatbots y agentes con IA de tu web: qué información se les puede sacar, cómo se les saca y cómo se cierra. Informe básico gratuito y remediación."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>Seguridad de IA</p>
    <h1
      class="mt-7 max-w-[18ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      Tu chatbot <span class="font-semibold text-oro-oscuro">cuenta más de lo que crees</span>.
    </h1>
    <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      Poner un asistente con IA en la web lleva una tarde. Auditarlo no lo hace casi nadie. Nosotros lo
      probamos como lo probaría alguien con malas intenciones y te enseñamos qué se le escapa.
    </p>
    <div class="mt-12 flex flex-wrap gap-4" data-reveal>
      <Boton href={href('/contacto/')}>Pedir el escaneo gratuito →</Boton>
      <Boton href={href('/estudio-asistentes-ia/')} variante="linea">Ver nuestro estudio</Boton>
    </div>
  </section>

  <!-- El problema -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Lo que se le puede sacar</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          No hace falta ser un atacante sofisticado. Basta con insistir bien.
        </h2>
        <p class="mt-6 text-[17px] text-pizarra">
          En septiembre de 2026 rastreamos 391 webs españolas y probamos los 41 asistentes que pudimos abrir.
          Uno de cada cuatro dejó escapar algo y cuatro estaban en crítico. Nadie vulneró nada: solo hubo que
          escribir en el chat.
        </p>
        <a
          href={href('/estudio-asistentes-ia/')}
          class="mt-5 inline-block font-mono text-[12px] text-oro-oscuro transition-colors hover:text-tinta"
        >
          Ver el estudio completo con los datos →
        </a>
      </div>

      <ul class="mt-16 grid gap-x-12 gap-y-12 md:grid-cols-2 lg:grid-cols-3" role="list">
        {
          fugas.map((f, i) => (
            <li data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 font-display text-[19px] font-semibold leading-[1.3]">{f.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{f.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Cómo lo hacemos -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-6" data-reveal>
          <p class="eyebrow">Cómo lo hacemos</p>
          <h2
            class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]"
          >
            Cuatro pasos, con LeakAI haciendo el trabajo pesado.
          </h2>
        </div>
        <div class="text-[17px] text-pizarra md:col-span-6 md:pt-12" data-reveal>
          <p>
            LeakAI es nuestra herramienta de auditoría. Detecta los asistentes publicados, los prueba y puntúa
            cada hallazgo. La construimos nosotros y la usamos en cada proyecto, así que el diagnóstico no
            depende de que alguien tenga la tarde libre.
          </p>
        </div>
      </div>

      <ol class="mt-16 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea md:grid-cols-2" role="list">
        {
          pasos.map((p, i) => (
            <li class="bg-panel p-8 md:p-10" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 font-display text-[20px] font-semibold leading-[1.3]">{p.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Qué te llevas -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow text-oro-luz">Qué te llevas</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          El diagnóstico es gratis. Lo que se paga es dejarlo cerrado.
        </h2>
      </div>

      <ul class="mt-16 grid gap-10 md:grid-cols-3" role="list">
        {
          entregables.map((e) => (
            <li class="border-t border-marfil/15 pt-8" data-reveal>
              <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-oro-luz">{e.etiqueta}</span>
              <h3 class="mt-4 font-display text-[20px] font-semibold leading-[1.3]">{e.titulo}</h3>
              <p class="mt-3 text-[15px] text-marfil/70">{e.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Normativa -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-5" data-reveal>
          <p class="eyebrow">Por qué te va a tocar igualmente</p>
          <h2
            class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]"
          >
            Un asistente sin auditar es un riesgo sin gestionar.
          </h2>
        </div>
        <ul class="md:col-span-7 md:pl-6" role="list">
          {
            normas.map((n) => (
              <li class="border-t border-linea py-8 first:border-t-0 first:pt-0 md:first:pt-2" data-reveal>
                <h3 class="font-display text-[19px] font-semibold">{n.norma}</h3>
                <p class="mt-3 text-[15px] text-pizarra">{n.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Cómo trabajamos esto -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-6" data-reveal>
        <p class="eyebrow">Los límites, por escrito</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Esto es un diagnóstico, no una amenaza.
        </h2>
      </div>
      <div class="space-y-5 text-[17px] text-pizarra md:col-span-6 md:pt-12" data-reveal>
        <p>
          Hablamos con el asistente como lo haría cualquier visitante, desde la web pública y a un ritmo
          limitado. No entramos en sistemas, no explotamos vulnerabilidades y no tocamos nada que no esté
          publicado.
        </p>
        <p>
          Los datos personales que aparezcan no se guardan en claro. Los hallazgos se enseñan solo al
          responsable de la empresa, nunca a terceros y nunca en público.
        </p>
      </div>
    </div>
  </section>

  <Cta
    titulo="Escaneamos tu asistente gratis. Después decides."
    texto="Nos dices tu dominio y te devolvemos el informe básico con la severidad y las categorías de fuga que hayamos encontrado. Sin compromiso y sin coste."
    boton="Pedir el escaneo"
  />
</Base>
