---
import Base from '../../layouts/Base.astro';
import Boton from '../../components/Boton.astro';
import Cta from '../../components/Cta.astro';
import { href } from '../../lib/site';

const resumen = [
  {
    etiqueta: 'Punto de partida',
    titulo: 'Diagnóstico',
    pie: '30 minutos · gratuito',
    ruta: '/servicios/#diagnostico',
  },
  {
    etiqueta: 'Proyecto puntual',
    titulo: 'Transformación operativa',
    pie: 'Implantación, integración y capacitación',
    ruta: '/servicios/#transformacion',
  },
  {
    etiqueta: 'Acompañamiento continuo',
    titulo: 'Partner tecnológico',
    pie: 'Criterio cualificado cada mes',
    ruta: '/servicios/#partner',
  },
];

const queObtienes = [
  {
    titulo: 'Identificación de áreas con potencial',
    texto: 'Mapeo preliminar de procesos donde la IA puede aportar valor medible en tu empresa.',
  },
  {
    titulo: 'Estado inicial documentado',
    texto: 'Diagnóstico de cómo está tu organización hoy en términos de procesos, datos y madurez digital.',
  },
  {
    titulo: 'Plan de trabajo recomendado',
    texto: 'Hoja de ruta priorizada: qué hacer primero, qué después, con plazos estimados.',
  },
  {
    titulo: 'Presupuesto orientativo',
    texto: 'Estimación honesta de la inversión necesaria por fase, sin tarifas inflacionadas ni letra pequeña.',
  },
  {
    titulo: 'Recomendación de tecnologías',
    texto: 'Qué herramientas, modelos y arquitectura tienen sentido para tu caso concreto.',
  },
];

const queIncluye = [
  {
    titulo: 'Implantación llave en mano',
    texto: 'Construimos las soluciones desde cero o adaptamos las nuestras a tu caso concreto.',
  },
  {
    titulo: 'Integración con tus sistemas',
    texto: 'Conectamos con tu ERP, CRM, WhatsApp, correo, agenda y cualquier herramienta que ya uses.',
  },
  {
    titulo: 'Automatización de procesos',
    texto: 'Diseñamos el flujo end-to-end, no solo el modelo. Human-in-the-loop por defecto.',
  },
  {
    titulo: 'Capacitación de tu equipo',
    texto: 'Formación a comerciales, administrativos y operaciones. Con casos prácticos de tu día a día.',
  },
  {
    titulo: 'Documentación y traspaso',
    texto: 'Al final del proyecto te quedas con código, claves, datos y manuales. Independencia real.',
  },
  {
    titulo: 'SLA y soporte mensual',
    texto: 'Acuerdo de nivel de servicio incluido durante el primer ciclo. Tiempos de respuesta comprometidos.',
  },
];

const fases = [
  {
    n: '01',
    titulo: 'Piloto',
    texto: 'Versión mínima funcionando en un proceso acotado. Validamos hipótesis antes de escalar.',
  },
  {
    n: '02',
    titulo: 'Integración',
    texto: 'Conexión con tus sistemas (ERP, CRM, WhatsApp, agenda). Datos fluyendo end-to-end.',
  },
  {
    n: '03',
    titulo: 'Despliegue',
    texto: 'Salida a producción y formación a tu equipo. Medición desde el día uno.',
  },
  {
    n: '04',
    titulo: 'Cierre',
    texto: 'Entrega de código, claves, datos y documentación. Independencia real.',
  },
];

const paquetes = [
  {
    nombre: 'Light',
    precio: '1.000 €/mes',
    horas: '10 horas mensuales',
    pie: '100 €/hora · ideal para arrancar',
  },
  {
    nombre: 'Standard',
    precio: '2.000 €/mes',
    horas: '25 horas mensuales',
    pie: '80 €/hora · empresas en fase activa',
  },
  {
    nombre: 'Plus',
    precio: '5.000 €/mes',
    horas: '75 horas mensuales',
    pie: '66 €/hora · transformación intensa',
  },
];

const ritmo = [
  { n: '01', titulo: 'Revisión', texto: 'mensual conjunta' },
  { n: '02', titulo: 'Interlocución', texto: 'con tus proveedores' },
  { n: '03', titulo: 'Hoja de ruta', texto: 'trimestral' },
  { n: '04', titulo: 'Auditoría', texto: 'SaaS y software' },
];

const cadaMes = [
  {
    titulo: 'Revisión de propuestas de proveedores',
    texto: 'Filtramos lo que llega a tu mesa: descartamos lo que no aporta, negociamos lo que sí.',
  },
  {
    titulo: 'Interlocución con consultoras y agencias',
    texto: 'Te acompañamos en reuniones técnicas para que no te lleven por donde no quieres ir.',
  },
  {
    titulo: 'Hoja de ruta IA actualizada',
    texto: 'Cada trimestre revisamos prioridades, inversiones y métricas. La hoja de ruta vive.',
  },
  {
    titulo: 'Auditoría de software y SaaS',
    texto: 'Identificamos solapamientos, gastos no usados y oportunidades de consolidación.',
  },
  {
    titulo: 'Canal directo Slack/WhatsApp',
    texto: 'Disponibilidad inmediata para consultas puntuales sin esperar a la reunión mensual.',
  },
];

const recorrido = [
  {
    n: '01',
    titulo: 'Diagnóstico',
    texto: '30 minutos de entrevista. Te entregamos propuesta con estado inicial, plan de trabajo y presupuesto.',
  },
  {
    n: '02',
    titulo: 'Decisión',
    texto: 'Tú decides el siguiente paso. Ningún compromiso hasta firmar el alcance del proyecto.',
  },
  {
    n: '03',
    titulo: 'Ejecución',
    texto: 'Implantamos, integramos y formamos a tu equipo. Piloto controlado antes del despliegue completo.',
  },
  {
    n: '04',
    titulo: 'Acompañamiento',
    texto:
      'Si quieres, continuamos como tu Partner tecnológico para escalar y mantener la transformación.',
  },
];

const faq = [
  {
    pregunta: '¿El diagnóstico realmente es gratuito? ¿Cuál es el truco?',
    respuesta:
      'No hay truco. Es nuestro punto de entrada. Si tras el diagnóstico no decides contratar nada, te quedas con la propuesta y plan de trabajo. Es información valiosa para ti y un coste razonable para nosotros si lo comparamos con un proyecto fallido por no haber entendido el caso.',
  },
  {
    pregunta: '¿Por qué no publicáis precios fijos del servicio de transformación?',
    respuesta:
      'Porque cada caso es distinto. Un proyecto de automatización conversacional en una clínica no se parece a uno de búsqueda inteligente en un despacho. Las tarifas cerradas obligan a inflar precio para los casos complejos o a aceptar pérdidas en los casos pequeños. Preferimos cotizar cada proyecto tras entenderlo.',
  },
  {
    pregunta: '¿En cuánto tiempo veo resultados medibles?',
    respuesta:
      'Depende del proyecto, pero por norma general entre 4 y 12 semanas desde el inicio. Trabajamos siempre por hitos cortos con métricas verificables, para que veas resultados antes de comprometer recursos al despliegue completo.',
  },
  {
    pregunta: '¿Mis datos están seguros?',
    respuesta:
      'Toda nuestra infraestructura está en la Unión Europea (Hetzner Frankfurt y proveedores EU). Cumplimos RGPD por defecto, sin dependencias de terceros países. Si trabajamos con sectores regulados (salud, legal, finanzas), añadimos las medidas específicas que tu sector requiera.',
  },
  {
    pregunta: '¿Qué pasa si quiero dejar de trabajar con vosotros?',
    respuesta:
      'Al finalizar cualquier proyecto te entregamos código, claves de acceso, datos y documentación. Tu empresa conserva todo el activo construido. El Partner tecnológico se revisa trimestralmente y puedes ajustarlo o pausarlo según evolucione tu empresa.',
  },
];
---

<Base
  title="Servicios"
  description="Diagnóstico gratuito, transformación operativa con IA y partner tecnológico. Tres formas de trabajar con 77 Delta para reducir costes y aumentar la producción de tu empresa."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>Servicios</p>
    <h1
      class="mt-7 max-w-[20ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      Tres formas de trabajar contigo. Un mismo objetivo: <span class="font-semibold text-oro-oscuro"
        >reducir costes</span
      > y aumentar tu producción con IA aplicada.
    </h1>
    <p class="mt-8 max-w-[52ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      Cada empresa es distinta. Por eso empezamos siempre por el diagnóstico. A partir de ahí, tú decides el
      recorrido: proyecto puntual, acompañamiento continuo o ambos. Sin tarifas cerradas. Sin compromiso inicial.
    </p>

    <div class="mt-16 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea md:grid-cols-3">
      {
        resumen.map((r) => (
          <a
            href={href(r.ruta)}
            class="group flex flex-col bg-panel p-8 transition-colors hover:bg-oro/5 md:p-10"
            data-reveal
          >
            <span class="eyebrow text-pizarra">{r.etiqueta}</span>
            <h2 class="mt-4 font-display text-[22px] font-semibold">{r.titulo}</h2>
            <p class="mt-3 flex-1 text-[15px] text-pizarra">{r.pie}</p>
            <span class="mt-8 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">Ver el detalle →</span>
          </a>
        ))
      }
    </div>

    <p class="mt-8 max-w-[60ch] font-mono text-[12px] leading-[1.7] text-pizarra" data-reveal>
      Puedes empezar por uno y sumar el otro cuando lo necesites. O combinarlos desde el inicio.
    </p>
  </section>

  <!-- 01 · Diagnóstico -->
  <section id="diagnostico" class="hairline scroll-mt-[68px]">
    <div class="wrap py-24 md:py-32">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-7" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">01</span>
          <p class="eyebrow mt-6 text-pizarra">Primer paso · gratuito · 30 minutos</p>
          <h2
            class="mt-3 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]"
          >
            Diagnóstico
          </h2>
          <p class="mt-6 max-w-[56ch] text-[17px] text-pizarra">
            30 minutos de entrevista estructurada y un formulario que nos permite entender tu realidad operativa.
            Recibes una propuesta personalizada con el estado inicial de tu empresa, plan de trabajo y presupuesto.
          </p>
        </div>
        <div class="md:col-span-5 md:pt-14" data-reveal>
          <div class="rounded-[4px] border border-linea p-8">
            <p class="font-display text-[34px] font-extralight leading-none tracking-[-0.03em] text-oro-oscuro">Gratuito</p>
            <p class="mt-4 font-mono text-[12px] text-pizarra">30 minutos · sin compromiso</p>
            <div class="mt-8">
              <Boton href={href('/contacto/')}>Reservar diagnóstico →</Boton>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-20 grid gap-10 md:grid-cols-12">
        <div class="md:col-span-4" data-reveal>
          <h3 class="font-display text-[19px] font-semibold">Para quién es</h3>
          <p class="mt-4 text-[15px] text-pizarra">
            Para cualquier empresa que quiera entender qué puede aportarle la inteligencia artificial. No importa el
            tamaño ni el sector. Es el primer paso natural antes de cualquier servicio de pago.
          </p>
          <h3 class="mt-12 font-display text-[19px] font-semibold">Cómo es la conversación</h3>
          <p class="mt-4 text-[15px] text-pizarra">
            No es una llamada comercial. Es una entrevista de descubrimiento profesional, con preguntas estructuradas
            sobre tu día a día, tus procesos críticos y tus cuellos de botella. Te escuchamos primero. Después te
            orientamos.
          </p>
        </div>
        <div class="md:col-span-8 md:pl-6" data-reveal>
          <h3 class="font-display text-[19px] font-semibold">Qué obtienes</h3>
          <ul class="mt-6" role="list">
            {
              queObtienes.map((q) => (
                <li class="border-t border-linea py-5">
                  <p class="font-display text-[16px] font-semibold">{q.titulo}</p>
                  <p class="mt-2 text-[15px] text-pizarra">{q.texto}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · Transformación operativa -->
  <section id="transformacion" class="hairline scroll-mt-[68px] bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-7" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">02</span>
          <p class="eyebrow mt-6 text-pizarra">Proyecto a medida · cotización en propuesta</p>
          <h2
            class="mt-3 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]"
          >
            Transformación operativa con IA
          </h2>
          <p class="mt-6 max-w-[56ch] text-[17px] text-pizarra">
            Ejecutamos la propuesta acordada tras el diagnóstico: implantación, integración con tus sistemas,
            automatización de procesos y capacitación de tu equipo. Todo lo que necesita la transformación de tu
            empresa.
          </p>
        </div>
        <div class="md:col-span-5 md:pt-14" data-reveal>
          <div class="rounded-[4px] border border-linea p-8">
            <p class="font-display text-[34px] font-extralight leading-none tracking-[-0.03em] text-oro-oscuro">
              Personalizado
            </p>
            <p class="mt-4 font-mono text-[12px] leading-[1.7] text-pizarra">
              La inversión se define en la propuesta, ajustada al alcance acordado tras el diagnóstico
            </p>
            <div class="mt-8">
              <Boton href={href('/contacto/')} variante="linea">Empezar por el diagnóstico →</Boton>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-20 grid gap-10 md:grid-cols-12">
        <div class="md:col-span-4" data-reveal>
          <h3 class="font-display text-[19px] font-semibold">Para quién es</h3>
          <p class="mt-4 text-[15px] text-pizarra">
            Para empresas que han identificado sus oportunidades de transformación tras el diagnóstico y quieren un
            equipo especializado que las ejecute. Cubrimos desde proyectos puntuales hasta transformaciones de varios
            trimestres.
          </p>
          <h3 class="mt-12 font-display text-[19px] font-semibold">Plazo típico</h3>
          <p class="mt-4 text-[15px] text-pizarra">
            Entre 4 y 12 semanas según el alcance. Los proyectos empiezan siempre por un piloto controlado antes del
            despliegue completo, para que puedas validar resultados antes de comprometer recursos.
          </p>
        </div>
        <div class="md:col-span-8 md:pl-6" data-reveal>
          <h3 class="font-display text-[19px] font-semibold">Qué incluye</h3>
          <ul class="mt-6" role="list">
            {
              queIncluye.map((q) => (
                <li class="border-t border-linea py-5">
                  <p class="font-display text-[16px] font-semibold">{q.titulo}</p>
                  <p class="mt-2 text-[15px] text-pizarra">{q.texto}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="mt-20">
        <h3 class="font-display text-[19px] font-semibold" data-reveal>Cuatro fases con un final claro</h3>
        <ol class="mt-8 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea md:grid-cols-4" role="list">
          {
            fases.map((f) => (
              <li class="bg-panel p-8" data-reveal>
                <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{f.n}</span>
                <p class="mt-5 font-display text-[18px] font-semibold">{f.titulo}</p>
                <p class="mt-3 text-[15px] text-pizarra">{f.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 03 · Partner tecnológico -->
  <section id="partner" class="hairline scroll-mt-[68px]">
    <div class="wrap py-24 md:py-32">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-7" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">03</span>
          <p class="eyebrow mt-6 text-pizarra">Mensualidad · acompañamiento continuo</p>
          <h2
            class="mt-3 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]"
          >
            Partner tecnológico
          </h2>
          <p class="mt-6 max-w-[56ch] text-[17px] text-pizarra">
            Criterio cualificado cada mes a tu lado. Revisamos propuestas tecnológicas, participamos en decisiones
            estratégicas e identificamos nuevas oportunidades cada mes. El criterio cualificado que necesita tu
            empresa, sin contratar a nadie en plantilla.
          </p>
        </div>
        <div class="md:col-span-5 md:pt-14" data-reveal>
          <div class="rounded-[4px] border border-linea p-8">
            <p class="font-display text-[34px] font-extralight leading-none tracking-[-0.03em] text-oro-oscuro">
              Desde 1.000 €/mes
            </p>
            <p class="mt-4 font-mono text-[12px] leading-[1.7] text-pizarra">
              Tres paquetes con descuento por volumen · revisión trimestral del servicio
            </p>
            <div class="mt-8">
              <Boton href={href('/contacto/')} variante="linea">Solicitar propuesta →</Boton>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-20" data-reveal>
        <h3 class="font-display text-[19px] font-semibold">Para quién es</h3>
        <p class="mt-4 max-w-[68ch] text-[15px] text-pizarra">
          Para empresas que no necesitan un Chief AI Officer en plantilla pero sí necesitan criterio cualificado en
          decisiones técnicas: evaluación de propuestas, interlocución con consultoras externas, decisiones de
          inversión tecnológica.
        </p>
      </div>

      <div class="mt-16">
        <h3 class="font-display text-[19px] font-semibold" data-reveal>Tres paquetes con descuento por volumen</h3>
        <ul class="mt-8 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea md:grid-cols-3" role="list">
          {
            paquetes.map((p) => (
              <li class="bg-panel p-8 md:p-10" data-reveal>
                <p class="eyebrow text-pizarra">{p.nombre}</p>
                <p class="mt-5 font-display text-[clamp(28px,3.4vw,38px)] font-extralight leading-none tracking-[-0.03em]">
                  {p.precio}
                </p>
                <p class="mt-4 text-[16px]">{p.horas}</p>
                <p class="mt-2 font-mono text-[12px] text-pizarra">{p.pie}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-20 grid gap-10 md:grid-cols-12">
        <div class="md:col-span-4" data-reveal>
          <h3 class="font-display text-[19px] font-semibold">El ritmo mensual</h3>
          <ol class="mt-6" role="list">
            {
              ritmo.map((r) => (
                <li class="flex gap-4 border-t border-linea py-4">
                  <span class="font-mono text-[11px] leading-[1.9] tracking-[0.14em] text-oro-oscuro">{r.n}</span>
                  <span class="text-[15px]">
                    <span class="font-semibold">{r.titulo}</span>{' '}
                    <span class="text-pizarra">{r.texto}</span>
                  </span>
                </li>
              ))
            }
          </ol>
          <p class="mt-6 font-mono text-[12px] leading-[1.7] text-pizarra">
            Canal directo · Slack / WhatsApp · siempre activo
          </p>
        </div>
        <div class="md:col-span-8 md:pl-6" data-reveal>
          <h3 class="font-display text-[19px] font-semibold">Qué hacemos cada mes</h3>
          <ul class="mt-6" role="list">
            {
              cadaMes.map((c) => (
                <li class="border-t border-linea py-5">
                  <p class="font-display text-[16px] font-semibold">{c.titulo}</p>
                  <p class="mt-2 text-[15px] text-pizarra">{c.texto}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Cupó IA -->
  <section id="cupo" class="hairline scroll-mt-[68px] bg-oro/[0.06]">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-28">
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow">Cupó IA d'ACCIÓ · Generalitat de Catalunya</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Hasta 8.000 € de tu proyecto los paga la Generalitat.
        </h2>
        <p class="mt-6 max-w-[58ch] text-[17px] text-pizarra">
          Somos proveedor acreditado de ACCIÓ. Si tu empresa tiene sede en Catalunya, al menos 10 trabajadores y
          un IAE elegible, gestionamos la solicitud completa y parte del coste del proyecto lo asume el programa.
          Lo comprobamos en 24 horas tras la conversación inicial.
        </p>
        <a href={href('/contacto/')} class="mt-8 inline-flex items-center gap-2 font-display text-[15px] text-oro-oscuro">
          Comprobar si tu empresa encaja →
        </a>
      </div>
      <ul class="grid gap-4 self-center md:col-span-5" role="list" data-reveal>
        {
          [
            ['Hasta 8.000 €', 'de subvención por proyecto'],
            ['24 h', 'para confirmar si encajas'],
            ['0 trámites', 'para ti: la solicitud la hacemos nosotros'],
          ].map(([cifra, texto]) => (
            <li class="flex items-baseline gap-4 rounded-[4px] border border-linea bg-panel px-5 py-4">
              <span class="shrink-0 whitespace-nowrap font-display text-[26px] font-extralight tracking-[-0.03em] text-oro-oscuro">{cifra}</span>
              <span class="text-[14px] text-pizarra">{texto}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- El recorrido típico -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">El recorrido típico</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          De una conversación a la transformación, en pasos claros
        </h2>
        <p class="mt-6 text-[17px] text-pizarra">
          Cada empresa avanza a su ritmo. No hay obligación de pasar de un paso al siguiente. La decisión es tuya en
          cada etapa.
        </p>
      </div>

      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          recorrido.map((p) => (
            <li class="border-t border-linea pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{p.n}</span>
              <h3 class="mt-4 font-display text-[19px] font-semibold">{p.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Lo que más nos preguntan antes de empezar
        </h2>
      </div>

      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
        <details class="group border-t border-linea py-5 last:border-b">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
            ¿Puedo aplicar el Cupó IA de la Generalitat con vosotros?
            <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">
            Sí. Somos proveedores acreditados ACCIÓ y gestionamos la solicitud completa. Si tu empresa cumple los
            requisitos (sede en Catalunya, mínimo 10 trabajadores, IAE elegible), parte del coste del proyecto lo
            asume la Generalitat. Lo verificamos en 24 horas tras la conversación inicial.
          </p>
          <a href={href('/contacto/')} class="mt-4 inline-block font-mono text-[12px] text-oro-oscuro hover:text-tinta">
            Comprobar si tu empresa encaja →
          </a>
        </details>
      </div>
    </div>
  </section>

  <Cta
    titulo="El primer paso es una conversación. Sin compromiso."
    texto="30 minutos para entender tu realidad y orientarte sobre cómo aplicar IA en tu empresa con criterio."
    boton="Reservar diagnóstico gratuito"
  />
</Base>
