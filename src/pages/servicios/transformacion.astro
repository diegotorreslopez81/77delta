---
import Base from '../../layouts/Base.astro';
import Boton from '../../components/Boton.astro';
import Cta from '../../components/Cta.astro';
import { href } from '../../lib/site';
import { queIncluye, fases, resumen } from '../../data/servicios';

const otros = resumen.filter((r) => r.titulo !== 'Transformación operativa');
---

<Base
  title="Transformación operativa con IA"
  description="Implantación, integración con tus sistemas, automatización de procesos y capacitación de tu equipo. De cuatro a doce semanas, empezando siempre por un piloto controlado."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>
      <a href={href('/servicios/')} class="transition-colors hover:text-tinta">Servicios</a> · 02 · Proyecto a medida
    </p>
    <h1
      class="mt-7 max-w-[19ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      Del prototipo a <span class="font-semibold text-oro-oscuro">producción</span>, con tu equipo dentro.
    </h1>
    <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      Ejecutamos la propuesta acordada tras el diagnóstico: implantación, integración con tus sistemas,
      automatización de procesos y capacitación de la gente que va a usarlo. Todo lo que necesita una
      transformación que no dependa de nosotros después.
    </p>

    <div class="mt-14 flex flex-wrap items-center gap-8" data-reveal>
      <div class="rounded-[4px] border border-linea bg-panel px-8 py-6">
        <p class="font-display text-[30px] font-extralight leading-none tracking-[-0.03em] text-oro-oscuro">
          Personalizado
        </p>
        <p class="mt-3 max-w-[34ch] font-mono text-[12px] leading-[1.6] text-pizarra">
          La inversión se define en la propuesta, ajustada al alcance
        </p>
      </div>
      <Boton href={href('/servicios/diagnostico/')}>Empezar por el diagnóstico →</Boton>
    </div>
  </section>

  <!-- Para quién y plazo -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-12 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-6" data-reveal>
        <p class="eyebrow">Para quién es</p>
        <p class="mt-6 text-[17px] text-pizarra">
          Para empresas que ya han identificado sus oportunidades en el diagnóstico y quieren un equipo
          especializado que las ejecute. Cubrimos desde proyectos puntuales hasta transformaciones de varios
          trimestres.
        </p>
      </div>
      <div class="md:col-span-6 md:pl-6" data-reveal>
        <p class="eyebrow">Plazo típico</p>
        <p class="mt-6 text-[17px] text-pizarra">
          Entre cuatro y doce semanas según el alcance. Siempre empezamos por un piloto controlado antes del
          despliegue completo, para que valides resultados antes de comprometer recursos.
        </p>
      </div>
    </div>
  </section>

  <!-- Qué incluye -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Qué incluye</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Seis piezas que van siempre juntas.
        </h2>
      </div>
      <ul class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-2 lg:grid-cols-3" role="list">
        {
          queIncluye.map((q, i) => (
            <li data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 font-display text-[19px] font-semibold leading-[1.3]">{q.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{q.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Las cuatro fases -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow text-oro-luz">Cómo se ejecuta</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Cuatro fases con un final claro.
        </h2>
        <p class="mt-6 text-[17px] text-marfil/70">
          El proyecto termina de verdad: con el código, las claves y la documentación en tu casa.
        </p>
      </div>
      <ol class="mt-16 grid gap-10 md:grid-cols-4" role="list">
        {
          fases.map((f) => (
            <li class="border-t border-marfil/15 pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-luz">{f.n}</span>
              <h3 class="mt-3 font-display text-[18px] font-semibold leading-[1.3]">{f.titulo}</h3>
              <p class="mt-3 text-[14px] text-marfil/65">{f.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Otros servicios -->
  <section class="hairline bg-panel">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow" data-reveal>Otras formas de trabajar</p>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-3" role="list">
        {
          otros.map((o) => (
            <li class="bg-panel" data-reveal>
              <a href={href(o.ruta)} class="group flex h-full flex-col p-8 transition-colors hover:bg-oro/5">
                <span class="eyebrow text-pizarra">{o.etiqueta}</span>
                <h3 class="mt-3 font-display text-[20px] font-semibold">{o.titulo}</h3>
                <p class="mt-2 flex-1 text-[15px] text-pizarra">{o.pie}</p>
                <span class="mt-6 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">Ver el detalle →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Cta />
</Base>
